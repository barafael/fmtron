WHITESPACE = _{ " " | "\n" | "\t" | "\r" }

COMMENT = { line_comment | block_comment }
// Only `\n` ends a line comment (a lone `\r` does not), matching the
// reference parser; a `\r` before the `\n` is trimmed when rendering.
line_comment = { "//" ~ line_comment_inner ~ ("\n" | &EOI) }
line_comment_inner = { (!"\n" ~ ANY)* }
block_comment = { "/*" ~ (!"*/" ~ (block_comment | ANY))* ~ "*/" }

// Per the RON grammar: `XID_Start | "_"` then `XID_Continue`; a raw identifier
// (`r#type`, `r#1`, `r#a.b-c`) may also start with and contain `.`, `+`, `-`.
ident = @{ "r#" ~ ident_raw_rest+ | ident_first ~ ident_rest* }
ident_first = { XID_START | "_" }
ident_rest = { XID_CONTINUE }
ident_raw_rest = { XID_CONTINUE | "." | "+" | "-" }

ron_file = { SOI ~ attribute* ~ value ~ EOI }
// Input with no value at all: blank, comments only, or attributes only. Tried
// after `ron_file` fails, to report "no RON data" instead of a parse error.
no_value = { SOI ~ attribute* ~ EOI }

attribute = {
    "#" ~ "!" ~ "[" ~ ( enable_attr | type_attr | schema_attr ) ~ "]"
}
enable_attr = {
    "enable" ~ "(" ~
    ident ~ ("," ~ ident)* ~ ","? ~
    ")"
}
type_attr = { "type" ~ "=" ~ string }
schema_attr = { "schema" ~ "=" ~ string }

value = { float | signed_int | bool | char | byte_char | byte_string | string | list | map | tuple_type | fields_type | unit_type }

// booleans — like `inf`/`NaN`, only at an identifier boundary, so they
// don't shadow identifiers such as `trueish` or `false_value`.
bool = @{ ("true" | "false") ~ !ident_rest }

// numbers
sign = { "+" | "-" }

signed_int = @{ sign? ~ unsigned_int ~ int_suffix? }
unsigned_int = { with_base | dec }
with_base = { "0" ~ ("x" ~ hex_digits | "b" ~ bin_digits | "o" ~ oct_digits) }

// Digit strings may carry `_` separators, including consecutive and trailing
// underscores, but must start with a real digit (so `0x_1`, `1._5` are
// rejected) — matching the reference parser's empirically pinned behavior.
// The exponent is the one place a leading underscore is allowed (`1e_3`).
dec = @{ ASCII_DIGIT+ ~ ( "_"* ~ ASCII_DIGIT+ )* ~ "_"* }
hex_digits = @{ ASCII_HEX_DIGIT+ ~ ( "_"* ~ ASCII_HEX_DIGIT+ )* ~ "_"* }
bin_digits = @{ bin_digit+ ~ ( "_"* ~ bin_digit+ )* ~ "_"* }
oct_digits = @{ oct_digit+ ~ ( "_"* ~ oct_digit+ )* ~ "_"* }
bin_digit = { "0" | "1" }
oct_digit = { '0'..'7' }
int_suffix = { "i8" | "i16" | "i32" | "i64" | "i128" | "u8" | "u16" | "u32" | "u64" | "u128" }

float = @{ float_std | float_frac | float_sci | float_int_suffix | special_float }
float_std = { sign? ~ dec ~ "." ~ dec? ~ float_exp? ~ float_suffix? }
float_frac = { sign? ~ "." ~ dec ~ float_exp? ~ float_suffix? }
float_sci = { sign? ~ dec ~ float_exp ~ float_suffix? }
// An integer literal carrying a float suffix (e.g. `7f32`, `0f64`) — no
// decimal point and no exponent. Must be tried before `signed_int`.
float_int_suffix = { sign? ~ dec ~ float_suffix }
float_exp = { ("e" | "E") ~ sign? ~ exp_digits }
exp_digits = @{ "_"* ~ ASCII_DIGIT+ ~ ( "_"* ~ ASCII_DIGIT+ )* ~ "_"* }
float_suffix = { "f32" | "f64" }
// `inf`/`NaN` must not shadow longer identifiers (`inf32`, `NaNfoo`): the
// keyword (plus optional suffix, e.g. `-NaNf32`) is only a special float when
// no identifier continuation follows.
special_float = @{ sign? ~ ("inf" | "NaN") ~ float_suffix? ~ !ident_rest }

// chars
char = ${ "'" ~ char_inner ~ "'" }
// Any single unescaped char, including `'` itself (`'''`) and a raw `\n` or
// `\r`, as the reference parser accepts.
char_inner = { "\\" ~ char_escape_code | !"\\" ~ ANY }

// strings
string = ${ string_std | string_raw }

string_std = { "\"" ~ string_std_inner ~ "\"" }
string_std_inner = { ("\\" ~ escape_code | !("\"" | "\\") ~ ANY)* }

string_raw = { "r" ~ PUSH("#"*) ~ "\"" ~ string_raw_inner ~ "\"" ~ POP }
string_raw_inner = { (!("\"" ~ PEEK) ~ ANY)* }

byte_string = ${ byte_string_raw | byte_string_std }
byte_string_raw = { "br" ~ PUSH("#"*) ~ "\"" ~ string_raw_inner ~ "\"" ~ POP }
byte_string_std = { "b" ~ "\"" ~ string_std_inner ~ "\"" }

// A byte literal such as `b'a'` or `b'\xFF'`: one ASCII character or a byte
// escape (no `\u{...}`). A raw newline is accepted, as the reference does.
byte_char = ${ "b'" ~ byte_char_inner ~ "'" }
byte_char_inner = { "\\" ~ byte_escape_code | !"\\" ~ ASCII }

// The escapes the reference parser accepts: `\n \r \t \\ \' \" \0`, exactly
// two hex digits after `\x`, and `\u{...}` with 1-6 hex digits. Anything else
// (`\z`, `\12`, `\x4`) is rejected. `\u{...}` values above U+10FFFF are
// accepted lexically (pest cannot express value ranges) and are a known
// residual tolerance documented in the fix plan.
escape_code = {
    "n" | "r" | "t" | "\\" | "'" | "\"" | "0"
    | "x" ~ ASCII_HEX_DIGIT{2}
    | "u" ~ "{" ~ ASCII_HEX_DIGIT{1,6} ~ "}"
}

// A char is one scalar value, so its `\x` escape must be ASCII (`\x00`-`\x7F`);
// strings may chain `\xHH` escapes into multi-byte UTF-8.
char_escape_code = {
    "n" | "r" | "t" | "\\" | "'" | "\"" | "0"
    | "x" ~ '0'..'7' ~ ASCII_HEX_DIGIT
    | "u" ~ "{" ~ ASCII_HEX_DIGIT{1,6} ~ "}"
}

// A byte literal takes any `\xHH` but no `\u{...}`.
byte_escape_code = {
    "n" | "r" | "t" | "\\" | "'" | "\"" | "0"
    | "x" ~ ASCII_HEX_DIGIT{2}
}

// collections
list = {
    "[" ~
    (value ~ ("," ~ value)* ~ ","?)? ~
    "]"
}

map = {
    "{" ~
    (map_entry ~ ("," ~ map_entry)* ~ ","?)? ~
    "}"
}
map_entry = { value ~ ":" ~ value }

unit_type = { ident }
tuple_type = {
    ident? ~ "(" ~
    (value ~ ("," ~ value)* ~ ","?)? ~
    ")"
}

fields_type = {
    ident? ~ "(" ~
    (field ~ ("," ~ field)* ~ ","?)? ~
    ")"
}
field = { ident ~ ":" ~ value }