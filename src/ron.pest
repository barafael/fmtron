WHITESPACE = _{ " " | "\n" | "\t" | "\r" }

COMMENT = { line_comment | block_comment }
line_comment = { "//" ~ line_comment_inner ~ (NEWLINE | &EOI) }
line_comment_inner = { (!NEWLINE ~ ANY)* }
block_comment = { "/*" ~ (!"*/" ~ (block_comment | ANY))* ~ "*/" }

ident = @{ ("r#")? ~ ident_first ~ ident_rest* }
ident_first = { ASCII_ALPHA | "_" | non_ascii }
ident_rest = { ASCII_ALPHANUMERIC | "_" | non_ascii }
non_ascii = { !('\u{00}' .. '\u{7F}') ~ ANY }

ron_file = { SOI ~ attribute* ~ value ~ EOI }

attribute = {
    "#" ~ "!" ~ "[" ~ ( enable_attr | type_attr | schema_attr ) ~ "]"
}
enable_attr = {
    "enable" ~ "(" ~
    ident ~ ("," ~ ident)* ~ ","? ~
    ")"
}
type_attr = { "type" ~ "=" ~ string }
schema_attr = { "schema" ~ "=" ~ string }

value = { float | signed_int | bool | char | byte_string | string | list | map | tuple_type | fields_type | unit_type }

// booleans
bool = { "true" | "false" }

// numbers
sign = { "+" | "-" }

signed_int = @{ sign? ~ unsigned_int ~ int_suffix? }
unsigned_int = { with_base | ASCII_DIGIT+ }
with_base = { "0" ~ ("x" | "b" | "o") ~ ASCII_HEX_DIGIT+ }
int_suffix = { "i8" | "i16" | "i32" | "i64" | "i128" | "u8" | "u16" | "u32" | "u64" | "u128" }

float = @{ float_std | float_frac | float_sci | float_int_suffix | special_float }
float_std = { sign? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* ~ float_exp? ~ float_suffix? }
float_frac = { sign? ~ "." ~ ASCII_DIGIT+ ~ float_exp? ~ float_suffix? }
float_sci = { sign? ~ ASCII_DIGIT+ ~ float_exp ~ float_suffix? }
// An integer literal carrying a float suffix (e.g. `7f32`, `0f64`) — no
// decimal point and no exponent. Must be tried before `signed_int`.
float_int_suffix = { sign? ~ ASCII_DIGIT+ ~ float_suffix }
float_exp = { ("e" | "E") ~ sign? ~ ASCII_DIGIT+ }
float_suffix = { "f32" | "f64" }
special_float = @{ sign? ~ ("inf" | "NaN") ~ float_suffix? }

// chars
char = ${ "'" ~ char_inner ~ "'" }
char_inner = { "\\'" | (!"'" ~ ANY)* }

// strings
string = ${ string_std | string_raw }

string_std = { "\"" ~ string_std_inner ~ "\"" }
string_std_inner = { ("\\\"" | !"\"" ~ ANY)* }

string_raw = { "r" ~ PUSH("#"*) ~ "\"" ~ string_raw_inner ~ "\"" ~ POP }
string_raw_inner = { (!("\"" ~ PEEK) ~ ANY)* }

byte_string = ${ byte_string_raw | byte_string_std }
byte_string_raw = { "br" ~ PUSH("#"*) ~ "\"" ~ string_raw_inner ~ "\"" ~ POP }
byte_string_std = { "b" ~ "\"" ~ string_std_inner ~ "\"" }

// collections
list = {
    "[" ~
    (value ~ ("," ~ value)* ~ ","?)? ~
    "]"
}

map = {
    "{" ~
    (map_entry ~ ("," ~ map_entry)* ~ ","?)? ~
    "}"
}
map_entry = { value ~ ":" ~ value }

unit_type = { ident }
tuple_type = {
    ident? ~ "(" ~
    (value ~ ("," ~ value)* ~ ","?)? ~
    ")"
}

fields_type = {
    ident? ~ "(" ~
    (field ~ ("," ~ field)* ~ ","?)? ~
    ")"
}
field = { ident ~ ":" ~ value }