// String escapes: control escapes, hex escapes, and \u{...} unicode escapes.
// Trailing-backslash cases guard the greedy-escape pitfall: a `\` immediately
// before the closing quote must not swallow it.
(
    escapes: "a\tb\nc\\d",
    quote: "say \"hi\"",
    hex_escape: "\x41\x42",
    unicode: "\u{1F600} is an emoji, \u{00E9} is e-acute",
    mixed: "tab\there\nand a \u{1F4A9}",
    empty: "",
    trailing_backslash: "ends with \\",
    just_a_backslash: "\\",
)
