(
    left_pane_width: 334.0,
    right_pane_width: 240.0,
    window_size: (1200.0, 800.0),
    window_pos: (0.0, 0.5),
    selected_model: "DS",
    selected_preamble: "crabot",
    selected_skills: ["rust"],
    preamble_enabled: true,
    skills_enabled: true,
    tools_enabled: true,
    workspace_enabled: true,
    agents_md_enabled: true,
    date_enabled: true,
    workspace: "",
    recent_workspaces: [],
    font_scale: 1.0,
    mcp_servers: {
        "exa": true,
        "codebase": false,
    },
    agent_tools: {
        "read": true,
        "write": true,
        "edit": true,
        "find": true,
        "search": true,
        "bash": true,
        "process": true,
        "ask": true,
        "todo": true,
        "task": true,
        "renew": true,
        "fetch": true,
        "crate_source": true,
        "web_search_exa": true,
        "web_fetch_exa": false,
    },
    prompt_recipes: {
        "plan": [
            "Plan the next steps to achieve the goal:",
            "Search web to find best practice for",
        ],
        "code": [
            "proceed",
            "fix build error",
            "fix these issues",
            "Refactor the staged changes, remove redundant code, rewrite code to be short and clear when possible. Make multi-line comment short and concise. Try reuse existed code.",
            "Summarize the implementation plan and call renew to proceed."
        ],
        "review": [
            "Review the staged changes for bugs, correctness issues, maintainability concerns, and possible improvements.",
            "Summarize user-facing benefit or feature introduced by the staged changes in a single sentence as commit message",
        ],
    },
    fill_ratio_threshold: 25.0,
    max_iterations: 100,
    stream_stall_timeout: 120,
    tool_limits: (
        command_timeout_ms: 120000,
        max_command_timeout_ms: 600000,
        head_tail_bytes: 3072,
        max_output_bytes: 102400,
        read_max_lines: 2000,
        read_max_bytes: 65536,
        find_max_lines: 100,
        search_max_lines: 500,
        fetch_max_body_bytes: 8388608,
        fetch_timeout_ms: 60000,
        mcp_connect_timeout_ms: 60000,
        mcp_call_timeout_ms: 300000,
    ),
    task_models: (
        easy: (
            provider_id: "deepseek",
            model_id: "deepseek-v4-flash",
            thinking: true,
            thinking_level: "high",
            context_window: 1048576,
        ),
        medium: (
            provider_id: "deepseek",
            model_id: "deepseek-v4-pro",
            thinking: true,
            thinking_level: "high",
            context_window: 1048576,
        ),
        hard: (
            provider_id: "",
            model_id: "",
            thinking: false,
            thinking_level: "",
            context_window: 0,
        ),
    ),
    auto_check_updates: true,
    use_system_proxy_for_llm: true,
    use_system_proxy_for_tools: true,
    last_update_version: None,
    appearance: System,
)
