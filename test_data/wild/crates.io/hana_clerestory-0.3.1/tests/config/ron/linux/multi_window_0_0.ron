(
    version: 3,
    entries: [
        (
            key: Primary,
            state: (
                // Monitor 0 (eDP) — 200px offset from monitor origin
                position: MonitorOffset((200, 200)),
                logical_width: 1000,
                logical_height: 700,
                monitor_index: 0,
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
        (
            key: Managed("window-1"),
            state: (
                // Secondary window also on Monitor 0 — offset from origin (must fit within monitor)
                position: MonitorOffset((400, 200)),
                logical_width: 1200,
                logical_height: 800,
                monitor_index: 0,
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
    ],
)
