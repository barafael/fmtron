(
    version: 3,
    entries: [
        (
            key: Primary,
            state: (
                // Monitor 1 (HDMI)
                position: MonitorOffset((200, 200)),
                logical_width: 800,
                logical_height: 600,
                monitor_index: 1,
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
        (
            key: Managed("window-1"),
            state: (
                // Secondary window on Monitor 0 (eDP) — 200px offset
                position: MonitorOffset((200, 200)),
                logical_width: 1200,
                logical_height: 800,
                monitor_index: 0,
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
    ],
)
