        body: (font: Sans, weight: Normal, size: 11.0, spacing: 0.0, color: Text),
        telemetry: (font: Mono, weight: Medium, size: 11.0, spacing: 0.0, color: Accent),
        mono: (font: Mono, weight: Normal, size: 10.0, spacing: 0.0, color: TextDim),
