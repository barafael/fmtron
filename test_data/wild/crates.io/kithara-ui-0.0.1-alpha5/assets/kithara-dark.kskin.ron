(
    schema: "kithara.skin",
    version: 1,
    id: "kithara-dark",
    palette: (
        bg: "#12121f",
        bg_deep: "#0b0b16",
        bg_inset: "#15152a",
        bg_panel: "#20203a",
        bg_footer: "#1b1b32",
        bg_panel_2: "#26264a",
        bg_select: "#26264a",
        line: "#3b3b67",
        line_dim: "#242442",
        line_inner: "#2a2a4c",
        line_soft: "#2a2a4c",
        line_hi: "#4a4a7a",
        line_pop: "#2f2f57",
        text: "#e6e6e6",
        text_dim: "#a7aac2",
        muted: "#6f7189",
        accent: "#bb9442",
        accent_strong: "#d6ad59",
        accent_soft: "#bb94422e",
        danger: "#e64d4d",
        success: "#66cc66",
        warning: "#e6b333",
        wave_low: "#eb298c",
        wave_mid: "#f2d129",
        wave_high: "#2ec7eb",
        shadow: "#000000",
    ),
    pictures: {
        "spinner": (source: "sprites/spinner.png", columns: 8, rows: 1),
    },
    // What the skin says about content it does not draw itself. A role is a
    // colour this skin already names, so an extension dressed in one follows
    // every skin written over this one without restating anything.
    custom: {
        "level-ladder": {
            "ground": Role(BgInset),
            "ink": Role(TextDim),
            "bar_low": Role(WaveLow),
            "bar_high": Role(WaveHigh),
            "bars": Number(12),
        },
    },
    layout: (
        page_background: Bg,
        grid_gap: 1.0,
        grid_pad: 0.0,
    ),
    scroll: (
        width: 3.0,
        inset: 1.0,
        min_length: 16.0,
        track: BgInset,
        thumb: LineHi,
    ),
    chrome: (
        frame: (radius: 0.0, border_width: 1.0, border: Line),
        secondary_frame: (radius: 0.0, border_width: 1.0, border: Line),
        header_frame: (radius: 0.0, border_width: 0.0, border: LineInner),
        chip_frame: (radius: 0.0, border_width: 0.0, border: Accent),
        title_frame: (radius: 0.0, border_width: 0.0, border: LineInner),
        chevron_frame: (radius: 0.0, border_width: 0.0, border: LineInner),
        footer_frame: (radius: 0.0, border_width: 0.0, border: LineInner),
        header_height: 26.0,
        chip_pad: 9.0,
        chevron_size: 26.0,
        chevron_icon_size: 10.0,
        chevron_stroke_width: 1.0,
        footer_height: 22.0,
        footer_pad: 10.0,
        inner_line_width: 1.0,
        panel_background: BgPanel,
        header_background: BgPanel,
        title_background: BgPanel2,
        chip_background: Accent,
        chip_text: (color: Bg, font: Mono, size: 9.0, spacing: 0.0, weight: Normal),
        title_text: (color: Text, font: Display, size: 11.0, spacing: 0.0, weight: Medium),
        chevron_color: Muted,
        footer_background: BgFooter,
        footer_text: (color: Muted, font: Mono, size: 9.0, spacing: 0.0, weight: Normal),
        inner_line: LineInner,
        corner_size: 10.0,
        corner_width: 2.0,
        corner_offset: 0.0,
        corner_color: Accent,
        drop_zone_color: Accent,
    ),
    drag: (
        frame: (radius: 2.0, border_width: 1.0, border: Accent),
        background: BgPanel2,
        text: (font: Mono, weight: Medium, size: 10.0, spacing: 0.0, color: Text),
        width: 208.0,
        height: 22.0,
        pad_x: 8.0,
    ),
    window: (
        titlebar_height: 26.0,
        resize_edge: 4.0,
        titlebar_padding_x: 10.0,
        titlebar_text: (font: Mono, weight: Normal, size: 9.0, spacing: 0.12, color: Muted),
        icon_color: Muted,
        icon_hover_color: TextDim,
        icon_stroke_width: 1.0,
        standard: Buttons(
            minus_icon_size: 11.0,
            maximize_icon_size: 10.0,
            close_icon_size: 11.0,
            gap: 12.0,
            padding: 12.0,
        ),
        compact: Buttons(
            minus_icon_size: 10.0,
            maximize_icon_size: 9.0,
            close_icon_size: 10.0,
            gap: 10.0,
            padding: 10.0,
        ),
        close_wide: Close(
            cell_size: 32.0,
            icon_size: 11.0,
            frame: None,
            divider: Some((1.0, LineInner)),
        ),
        close_micro: Close(
            cell_size: 28.0,
            icon_size: 10.0,
            frame: None,
            divider: None,
        ),
        close_framed: Close(
            cell_size: 22.0,
            icon_size: 10.0,
            frame: (radius: 0.0, border_width: 1.0, border: Line),
            divider: None,
        ),
    ),
    knob: (
        size: (w: Fixed(28.0), h: Fixed(39.0)),
        body_ratio: 0.68,
        body_fill: BgSelect,
        body_border: Line,
        track_color: Line,
        value_color: Accent,
        indicator_color: Text,
        drag_range: 140.0,
        wheel_step: 0.02,
        indicator_width: 2.0,
        outer_inset: 3.0,
        start_angle: 2.3561945,
        neutral_angle: 4.712389,
        sweep_angle: 4.712389,
        track_width: 2.0,
        track_alpha: 1.0,
        body_border_width: 1.0,
        label_text: (font: Mono, weight: Normal, size: 7.0, spacing: 0.1, color: Muted),
        label_gap: 2.0,
        label_height: 9.0,
    ),
    crossfader: (
        size: (w: Fixed(220.0), h: Fixed(64.0)),
        padding_x: 14.0,
        padding_top: 8.0,
        padding_bottom: 12.0,
        rail_height: 6.0,
        rail_frame: (radius: 0.0, border_width: 1.0, border: LineSoft),
        rail_background: BgInset,
        thumb_width: 10.0,
        thumb_height: 16.0,
        thumb_color: Accent,
        thumb_notch_width: 1.0,
        thumb_notch_height: 10.0,
        thumb_notch_color: Bg,
        ticks: (
            count: 11,
            thickness: 1.0,
            length: 6.0,
            center_length: 10.0,
            gap: 5.0,
            inset: 2.0,
            color: Line,
            center_color: TextDim,
        ),
        label_text: (color: Muted, font: Mono, size: 9.0, spacing: 0.0, weight: Normal),
        label_gap: 4.0,
        letter_text: (color: TextDim, font: Mono, size: 10.0, spacing: 0.0, weight: Normal),
        arrow_size: 10.0,
        arrow_color: Muted,
        arrow_gap: 2.0,
    ),
    vu_stereo: (
        size: (w: Fixed(64.0), h: Fixed(22.0)),
        carriage_width: 2.0,
        channel_l_y: 2.0,
        channel_r_y: 14.0,
        segment_count: 16,
        segment_gap: 1.0,
        segment_height: 8.0,
        segment_width: 3.0,
        warning_threshold: 0.66,
        danger_threshold: 0.83,
    ),
    vu_vertical: (
        size: (w: Fixed(38.0), h: Fixed(120.0)),
        fader_width: 18.0,
        segment_gap: 2.0,
        segment_height: 4.0,
        segment_inset_x: 4.0,
        ticks: (
            count: 11,
            thickness: 1.0,
            length: 8.0,
            center_length: 14.0,
            gap: 6.0,
            inset: 2.0,
            color: Line,
            center_color: TextDim,
        ),
        thumb_height: 9.0,
        thumb_color: Accent,
        thumb_notch_offset: 4.0,
        thumb_notch_height: 1.0,
        thumb_notch_color: Bg,
        warning_threshold: 0.66,
        danger_threshold: 0.83,
    ),
    vis: (
        size: (w: Fill, h: Fixed(300.0)),
        header_height: 26.0,
        footer_height: 22.0,
        nav_cell_size: 26.0,
        nav_padding_x: 0.0,
        nav_padding_y: 0.0,
        name_padding_x: 10.0,
        index_padding_x: 9.0,
        footer_padding_x: 10.0,
        nav_text: (color: TextDim, font: Mono, size: 11.0, spacing: 0.0, weight: Normal),
        nav_frame: (radius: 0.0, border_width: 1.0, border: LineInner),
        nav_fill: (hovered: BgSelect, idle: BgPanel2, pressed: AccentSoft),
        icon_size: 10.0,
        icon_color: Muted,
    ),
    toggle: (
        size: (w: Fixed(26.0), h: Fixed(14.0)),
        active: (content: BgDeep, fill: Accent),
        idle: (content: Muted, fill: None),
        active_frame: (radius: 0.0, border_width: 0.0, border: Line),
        inactive_frame: (radius: 0.0, border_width: 1.0, border: Muted),
        thumb_size: 9.0,
        thumb_inset: 2.0,
        thumb_radius: 0.0,
    ),
    checkbox: (
        size: (w: Fixed(10.0), h: Fixed(10.0)),
        active: (content: BgDeep, fill: Accent),
        idle: (content: Muted, fill: None),
        active_frame: (radius: 0.0, border_width: 1.0, border: Line),
        inactive_frame: (radius: 0.0, border_width: 1.0, border: Muted),
    ),
    readout: (
        size: (w: Range(min: 40.0, max: None), h: Fixed(26.0)),
        frame: (radius: 0.0, border_width: 1.0, border: Line),
        padding_x: 6.0,
        padding_y: 0.0,
        spacing: 2.0,
        tones: (accent: Accent, danger: Danger, neutral: Text, success: Success),
        label: (color: Muted, font: Mono, size: 8.0, spacing: 0.0, weight: Normal),
        value: (color: Text, font: Mono, size: 11.0, spacing: 0.0, weight: Normal),
    ),
    chip: (
        size: (w: Range(min: 24.0, max: None), h: Fixed(18.0)),
        active_frame: (radius: 0.0, border_width: 0.0, border: Line),
        inactive_frame: (radius: 0.0, border_width: 1.0, border: Line),
        pivot_frame: (radius: 0.0, border_width: 1.0, border: Line),
        padding_x: 8.0,
