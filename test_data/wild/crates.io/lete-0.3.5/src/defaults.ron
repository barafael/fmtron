(
    ignore_patterns: [
        ".git/",
        "node_modules/",
        "target/",
        "vendor/",
        "__pycache__/",
        ".venv/",
        "venv/",
        ".next/",
        ".nuxt/",
        "coverage/",
        "obj",
        ".vs",
    ],

    generated_patterns: [
        "dist/",
        "build/",
        ".lock",
        "-lock.json",
        ".tsbuildinfo",
        ".map",
        ".min.js",
        ".min.css",
        ".generated.",
        "_generated",
        "generated/",
    ],

    docs_extensions: ["md", "mdx", "rst"],

    docs_patterns: [
        "readme",
        "docs/",
        "documentation/",
        "changelog",
        "license",
    ],

    test_patterns: [
        ".test.",
        ".spec.",
        "_test.",
        "_spec.",
        "__tests__",
        "tests/",
        "test/",
        "_test/",
    ],

    config_extensions: ["json", "toml", "yaml", "yml", "ini"],

    config_patterns: [
        "config",
        ".env",
        "webpack",
        "vite",
        "tsconfig",
        "eslint",
        "prettier",
        ".rc",
    ],

    ui_patterns: [
        "components/",
        "pages/",
        "views/",
        "ui/",
        "screens/",
        "layouts/",
        "widgets/",
    ],

    auth_patterns: [
        "auth/",
        "session/",
        "login",
        "user/",
        "users/",
        "identity/",
        "oauth/",
        "account/",
        "accounts/",
    ],

    backend_patterns: [
        "api/",
        "services/",
        "controllers/",
        "models/",
        "db/",
        "database/",
        "handlers/",
        "routes/",
        "repositories/",
    ],

    testing_patterns: [
        "test",
        "spec",
        "mock",
        "fixture",
        "stub",
    ],

    error_patterns: [
        "error/",
        "errors/",
        "exception",
        "panic",
        "fault",
    ],

    model_patterns: [
        "models/",
        "entities/",
        "domain/",
        "schema/",
        "types/",
    ],

    util_patterns: [
        "utils/",
        "util/",
        "helpers/",
        "lib/",
        "common/",
        "shared/",
    ],

    security_patterns: [
        "security/",
        "crypto/",
        "encryption/",
        "permission/",
        "acl/",
        "rbac/",
    ],

    synonyms: [
        (canonical: "auth", synonyms: ["authenticate", "authentication", "login", "signin", "sign-in", "logout", "signout", "sign-out", "jwt", "oauth", "token", "session"]),
        (canonical: "db", synonyms: ["database", "storage", "persistence", "repository", "repo", "store", "datastore"]),
        (canonical: "api", synonyms: ["endpoint", "route", "handler", "controller", "rest", "graphql", "rpc"]),
        (canonical: "ui", synonyms: ["component", "widget", "view", "screen", "interface", "frontend", "front-end", "page"]),
        (canonical: "test", synonyms: ["spec", "unit", "integration", "e2e", "testing", "tests"]),
        (canonical: "config", synonyms: ["settings", "options", "preferences", "env", "environment", "configuration"]),
        (canonical: "error", synonyms: ["exception", "fault", "failure", "panic", "crash", "bug", "issue"]),
        (canonical: "model", synonyms: ["entity", "schema", "type", "struct", "class", "domain", "dto"]),
        (canonical: "util", synonyms: ["utility", "helper", "helpers", "utils", "common", "shared", "lib"]),
        (canonical: "security", synonyms: ["crypto", "encryption", "decrypt", "permission", "permissions", "acl", "rbac", "role", "roles"]),
        (canonical: "user", synonyms: ["users", "account", "accounts", "profile", "profiles", "member", "members"]),
        (canonical: "service", synonyms: ["services", "provider", "providers", "client", "clients"]),
        (canonical: "data", synonyms: ["datum", "record", "records", "item", "items", "entry", "entries"]),
        (canonical: "validate", synonyms: ["validation", "validator", "validators", "verify", "verification", "check"]),
        (canonical: "create", synonyms: ["add", "new", "insert", "post", "make", "generate"]),
        (canonical: "update", synonyms: ["edit", "modify", "patch", "change", "alter"]),
        (canonical: "delete", synonyms: ["remove", "destroy", "drop", "erase"]),
        (canonical: "fetch", synonyms: ["get", "retrieve", "load", "read", "query"]),
        (canonical: "list", synonyms: ["index", "all", "collection", "array"]),
        (canonical: "middleware", synonyms: ["interceptor", "filter", "guard", "hook", "hooks"]),
        (canonical: "cache", synonyms: ["caching", "memoize", "memoization", "store"]),
        (canonical: "log", synonyms: ["logging", "logger", "trace", "tracing", "debug"]),
        (canonical: "parse", synonyms: ["parsing", "parser", "deserialize", "decode"]),
        (canonical: "serialize", synonyms: ["serialization", "encode", "encoding", "marshal"]),
        (canonical: "render", synonyms: ["rendering", "draw", "display", "show"]),
        (canonical: "style", synonyms: ["styles", "styling", "css", "scss", "sass", "less", "theme", "themes"]),
        (canonical: "state", synonyms: ["states", "store", "redux", "context", "atom", "signal"]),
        (canonical: "hook", synonyms: ["hooks", "use", "callback", "effect"]),
        (canonical: "form", synonyms: ["forms", "input", "inputs", "field", "fields"]),
        (canonical: "button", synonyms: ["btn", "buttons", "action", "actions"]),
        (canonical: "modal", synonyms: ["dialog", "popup", "overlay"]),
        (canonical: "nav", synonyms: ["navigation", "navbar", "menu", "sidebar", "header"]),
        (canonical: "perf", synonyms: ["performance", "optimize", "optimization", "speed", "fast", "slow"]),
        (canonical: "async", synonyms: ["await", "promise", "future", "concurrent", "parallel"]),
    ],

    scoring_weights: (
        filename_match: 50.0,
        word_boundary_bonus: 30.0,
        directory_context: 20.0,
        code_file_boost: 10.0,
        config_file_boost: 5.0,
        test_file_penalty: -10.0,
        docs_file_penalty: -5.0,
        generated_file_penalty: -50.0,
        recency_7d: 15.0,
        recency_30d: 5.0,
        large_file_boost: 10.0,
        small_file_penalty: -10.0,
        multi_keyword_bonus: 25.0,
        entry_point_boost: 20.0,
        symbol_match: 40.0,
        import_count_factor: 2.0,
        depth_penalty_per_level: -2.0,
        content_keyword_match: 18.0,
        content_all_keywords_bonus: 30.0,
        content_match_docs_factor: 0.4,
    ),

    entry_point_patterns: [
        "main.rs",
        "lib.rs",
        "mod.rs",
        "index.ts",
        "index.js",
        "index.tsx",
        "index.jsx",
        "main.ts",
        "main.js",
        "app.ts",
        "app.js",
        "app.tsx",
        "app.jsx",
        "App.tsx",
        "App.jsx",
        "app.py",
        "main.py",
        "__main__.py",
        "__init__.py",
        "main.go",
        "cmd/",
        "application.ex",
        "router.ex",
        "endpoint.ex",
    ],
)
