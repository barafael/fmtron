Config(
    host: "127.0.0.1",
    port: "6600",
    event_threads: 5,
    keys: {
        Global: {
            "space": TogglePause,
            "q": Quit,
            "g+t": SetTab(Next),
            "g+T": SetTab(Prev),
            "b": Chain(SetTab(Next), Chain(MoveCursor(Next), MoveCursor(Next))),
            "n": Parallel(MoveCursor(Next), Parallel(MoveCursor(Next), Parallel(MoveCursor(Prev), MoveCursor(Prev)))),
            "m": Chain(MoveCursor(Next), Chain(MoveCursor(Next), Chain(MoveCursor(Prev), MoveCursor(Prev)))),
            "alt-1": SetTab(Tab(Library)),
            "alt-2": SetTab(Tab(Playlists)),
            "alt-3": SetTab(Tab(Queue)),
            "plus": ChangeVolume(Number(1)),
            "minus": ChangeVolume(Number(-1)),
            "right": Seek(Number(5)),
            "left": Seek(Number(-5)),
            "s": Seek(Input("Seek")),
            "r": Rescan,
            ":": Command(Input("Run command")),
        },
        List: {
            "k": MoveCursor(Prev),
            "j": MoveCursor(Next),
            "up": MoveCursor(Prev),
            "down": MoveCursor(Next),
            "g+g": MoveCursor(First),
            "G": MoveCursor(Last),
            "enter": Play(ListEntry(Selected)),
        },
        Library: {
            "l": ListExpand(Selected),
            "h": ListCollapse,
        },
    },
    theme: {
        Border: "#605C4E",
        FrameTitle: "#605C4E",
        TabTitle: "#A49966",
        ContentText: "#87967b",
        Player: "#C7C7A6",
    },
)
