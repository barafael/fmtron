(
    hot_reload: true,
    style_dirs: ["demos/styles"],
    default_style: Some("bigscreen_card"),
    clear_color: Some((r: 0.0019, g: 0.0044, b: 0.0081, a: 1.0)),
    start_root: "shelf",
    roots: [
        (
            name: "shelf",
            scroll_panes: [
                (
                    id: "main_pane",
                    x: 0.0, y: -540.0,
                    width: 0.0, height: 1015.0,
                    pad_left: 0.0, pad_right: 0.0,
                    pad_top: 0.0, pad_bottom: 0.0,
                    gap: 0.0,
                    horizontal: false,
                    full_span: true,
                    manual: true,
                    style: Some("shelf_bg"),
                    items: [

                        // ── Horizontal game shelf ──────────────────────────
                        ScrollPane((
                            id: "game_shelf",
                            x: 0.0, y: -400.0,
                            width: 0.0, height: 456.0,
                            pad_left: 40.0, pad_right: 40.0,
                            pad_top: 20.0, pad_bottom: 20.0,
                            gap: 24.0,
                            horizontal: true,
                            full_span: true,
                            style: Some("shelf_bg"),
                            items: [
                                Button(( id: "game_1",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 1",  tooltip: None, on_press: Custom("launch_game_1"),  nav_default: true )),
                                Button(( id: "game_2",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 2",  tooltip: None, on_press: Custom("launch_game_2")  )),
                                Button(( id: "game_3",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 3",  tooltip: None, on_press: Custom("launch_game_3")  )),
                                Button(( id: "game_4",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 4",  tooltip: None, on_press: Custom("launch_game_4")  )),
                                Button(( id: "game_5",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 5",  tooltip: None, on_press: Custom("launch_game_5")  )),
                                Button(( id: "game_6",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 6",  tooltip: None, on_press: Custom("launch_game_6")  )),
                                Button(( id: "game_7",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 7",  tooltip: None, on_press: Custom("launch_game_7")  )),
                                Button(( id: "game_8",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 8",  tooltip: None, on_press: Custom("launch_game_8")  )),
                                Button(( id: "game_9",  x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 9",  tooltip: None, on_press: Custom("launch_game_9")  )),
                                Button(( id: "game_10", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 10", tooltip: None, on_press: Custom("launch_game_10") )),
