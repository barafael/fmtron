                                Button(( id: "game_18", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 18", tooltip: None, on_press: Custom("launch_game_18") )),
                                Button(( id: "game_19", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 19", tooltip: None, on_press: Custom("launch_game_19") )),
                                Button(( id: "game_20", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 20", tooltip: None, on_press: Custom("launch_game_20") )),
                                Button(( id: "game_21", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 21", tooltip: None, on_press: Custom("launch_game_21") )),
                                Button(( id: "game_22", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 22", tooltip: None, on_press: Custom("launch_game_22") )),
                                Button(( id: "game_23", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 23", tooltip: None, on_press: Custom("launch_game_23") )),
                                Button(( id: "game_24", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 24", tooltip: None, on_press: Custom("launch_game_24") )),
                                Button(( id: "game_25", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 25", tooltip: None, on_press: Custom("launch_game_25") )),
                                Button(( id: "game_26", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 26", tooltip: None, on_press: Custom("launch_game_26") )),
                                Button(( id: "game_27", x: 0.0, y: 0.0, width: 286.0, height: 416.0, text: "Game 27", tooltip: None, on_press: Custom("launch_game_27") )),
