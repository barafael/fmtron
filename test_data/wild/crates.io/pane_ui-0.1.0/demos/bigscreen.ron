                            ],
                        )),

                        // ── Tab selector row  (y = shelf bottom + gap) ────
                        Button(( id: "tab_btn_featured", x: -290.0, y: 78.0, width: 180.0, height: 44.0,
                                 text: "Featured", style: Some("bigscreen_button"),
                                 on_press: SwitchTabPage(tab_id: "bottom_tab", page: 0), tooltip: None )),
                        Button(( id: "tab_btn_recent",   x:  -90.0, y: 78.0, width: 180.0, height: 44.0,
                                 text: "Recent",   style: Some("bigscreen_button"),
                                 on_press: SwitchTabPage(tab_id: "bottom_tab", page: 1), tooltip: None )),
                        Button(( id: "tab_btn_wishlist", x:  110.0, y: 78.0, width: 180.0, height: 44.0,
                                 text: "Wishlist", style: Some("bigscreen_button"),
                                 on_press: SwitchTabPage(tab_id: "bottom_tab", page: 2), tooltip: None )),

                        // ── Tab content ────────────────────────────────────
                        Tab((
                            id: "bottom_tab",
                            x: 0.0, y: 132.0,
                            width: 0.0, height: 500.0,
                            full_span: true,
                            pad_left: 24.0, pad_right: 24.0,
                            pad_top: 16.0, pad_bottom: 16.0,
                            gap: 12.0,
                            style: Some("shelf_bg"),
                            pages: [
                                (
                                    label: "Featured",
                                    items: [
                                        Button(( id: "feat_1",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> NEW RELEASE: Stellar Drift",         on_press: Custom("feat_1"),  tooltip: None )),
                                        Button(( id: "feat_2",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> DEAL: Iron Bastion  -60%",            on_press: Custom("feat_2"),  tooltip: None )),
                                        Button(( id: "feat_3",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> TRENDING: Void Protocol",             on_press: Custom("feat_3"),  tooltip: None )),
                                        Button(( id: "feat_4",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> COMING SOON: Echoes of the Rift",     on_press: Custom("feat_4"),  tooltip: None )),
                                        Button(( id: "feat_5",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> DEAL: Neon Abyss II  -40%",           on_press: Custom("feat_5"),  tooltip: None )),
                                        Button(( id: "feat_6",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> NEW RELEASE: Depths of Karath",       on_press: Custom("feat_6"),  tooltip: None )),
                                        Button(( id: "feat_7",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> SPOTLIGHT: Rimworld DLC — Ideology",  on_press: Custom("feat_7"),  tooltip: None )),
                                        Button(( id: "feat_8",  x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: ">> DEAL: Disco Elysium  -75%",           on_press: Custom("feat_8"),  tooltip: None )),
                                    ],
                                ),
                                (
                                    label: "Recent",
                                    items: [
                                        Button(( id: "recent_1", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Neon Abyss            Last played: 2h ago",    on_press: Custom("recent_1"), tooltip: None )),
                                        Button(( id: "recent_2", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Hollow Knight         Last played: yesterday",  on_press: Custom("recent_2"), tooltip: None )),
                                        Button(( id: "recent_3", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Deep Rock Galactic    Last played: 3 days ago", on_press: Custom("recent_3"), tooltip: None )),
                                        Button(( id: "recent_4", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Void Protocol         Last played: 5 days ago", on_press: Custom("recent_4"), tooltip: None )),
                                        Button(( id: "recent_5", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Iron Bastion          Last played: 1 week ago",  on_press: Custom("recent_5"), tooltip: None )),
                                        Button(( id: "recent_6", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Stellar Drift         Last played: 2 weeks ago", on_press: Custom("recent_6"), tooltip: None )),
                                        Button(( id: "recent_7", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Caves of Qud          Last played: 3 weeks ago", on_press: Custom("recent_7"), tooltip: None )),
                                    ],
                                ),
                                (
                                    label: "Wishlist",
                                    items: [
                                        Button(( id: "wish_1", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Silksong              Notify on release", on_press: Custom("wish_1"), tooltip: None )),
                                        Button(( id: "wish_2", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Frostpunk 2           Notify on sale",    on_press: Custom("wish_2"), tooltip: None )),
                                        Button(( id: "wish_3", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Caves of Qud          Notify on release", on_press: Custom("wish_3"), tooltip: None )),
                                        Button(( id: "wish_4", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Against the Storm     Notify on sale",    on_press: Custom("wish_4"), tooltip: None )),
                                        Button(( id: "wish_5", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Echoes of the Rift    Notify on release", on_press: Custom("wish_5"), tooltip: None )),
                                        Button(( id: "wish_6", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Depths of Karath      Notify on release", on_press: Custom("wish_6"), tooltip: None )),
                                        Button(( id: "wish_7", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "SOMA                  Notify on sale",    on_press: Custom("wish_7"), tooltip: None )),
                                        Button(( id: "wish_8", x: 0.0, y: 0.0, width: 1352.0, height: 80.0, text: "Kenshi 2              Notify on release", on_press: Custom("wish_8"), tooltip: None )),
                                    ],
                                ),
                            ],
                        )),
                    ],
                ),
            ],
            popouts: [
                (
                    id: "sidebar",
                    // Closed: panel is off-screen left; 50px toggle tab peeks out at x=-960
                    closed_x: -1210.0,
                    closed_y: -540.0,
                    // Open: panel flush against the left edge
                    open_x: -960.0,
                    open_y: -540.0,
                    width: 450.0,
                    height: 1080.0,
                    full_span: true,
                    edge: Left,
                    shadow: true,
                    home_toggles: true,
                    toggle_id: "sidebar_toggle",
                    style: Some("sidebar_bg"),
                    items: [
                        // Toggle tab — peeks from the left edge at all times
                        Button(( id: "sidebar_toggle", x: 450.0, y: 490.0,  width: 50.0,  height: 100.0,
                                 text: "=", style: Some("sidebar_item"), on_press: Custom("noop"), tooltip: None )),
                        // Header label
                        Button(( id: "sidebar_header", x: 0.0,  y: 176.0,  width: 450.0, height: 80.0,
                                 text: "Home", style: Some("sidebar_item"), on_press: Custom("noop"), tooltip: None, nav_default: false )),
                        Button(( id: "nav_library",  x: 0.0, y: 260.0, width: 450.0, height: 80.0,
                                 text: "Library",  style: Some("sidebar_item"), on_press: Custom("nav_library"),  tooltip: None )),
                        Button(( id: "nav_store",    x: 0.0, y: 344.0, width: 450.0, height: 80.0,
                                 text: "Store",    style: Some("sidebar_item"), on_press: Custom("nav_store"),    tooltip: None )),
                        Button(( id: "nav_friends",  x: 0.0, y: 428.0, width: 450.0, height: 80.0,
                                 text: "Friends",  style: Some("sidebar_item"), on_press: Custom("nav_friends"),  tooltip: None )),
                        Button(( id: "nav_media",    x: 0.0, y: 512.0, width: 450.0, height: 80.0,
                                 text: "Media",    style: Some("sidebar_item"), on_press: Custom("nav_media"),    tooltip: None )),
                        Button(( id: "nav_downloads",x: 0.0, y: 596.0, width: 450.0, height: 80.0,
                                 text: "Downloads",    style: Some("sidebar_item"), on_press: Custom("nav_downloads"),    tooltip: None )),
                        Button(( id: "nav_settings", x: 0.0, y: 680.0, width: 450.0, height: 80.0,
                                 text: "Settings", style: Some("sidebar_item"), on_press: Custom("nav_settings"), tooltip: None )),
                        // Footer
                        Button(( id: "nav_power",    x: 0.0, y: 764.0, width: 450.0, height: 84.0,
                                 text: "Power",    style: Some("sidebar_item"), on_press: Custom("nav_power"),    tooltip: None )),
                    ],
                ),
            ],
            bars: [
                (
                    id: "hint_bar",
                    edge: Bottom,
                    thickness: 65.0,
                    pad: 5.0,
                    gap: 5.0,
                    style: Some("bigscreen_bar"),
                    items: [
                        Spacer,
                        Button(( id: "hint_back",   width: 100.0, height: 120.0, text: "Options", style: "bigscreen_button",   on_press: Custom("hint_back")   )),
                        Button(( id: "hint_select", width: 100.0, height: 120.0, text: "A  Select",  style: "bigscreen_button", on_press: Custom("hint_select") )),
                        Button(( id: "hint_back",   width: 100.0, height: 120.0, text: "B  Back", style: "bigscreen_button",   on_press: Custom("hint_back")   )),
                        

                    ],
