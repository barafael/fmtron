[
    (
        id: "pointer-drag-commits",
        group: "drag",
        what: "captured pointer motion commits the exact displacement",
        pointer_drag: Some((from: "button:Drag handle", dx: 60.0, dy: 30.0, steps: 3)),
        subject: "heading:Drag committed", expect: PaintsNamed,
    ),
    (
        id: "pointer-drag-cancels",
        group: "cancel",
        what: "pointer cancellation restores the gesture origin",
        pointer_drag: Some((from: "button:Drag handle", dx: 60.0, dy: 30.0, steps: 3, cancel: true)),
        subject: "heading:Drag cancelled", expect: PaintsNamed,
    ),
    (
        id: "explicit-gridcell-activates",
        group: "gridcell",
        what: "a native button with an explicitly requested gridcell role is operable",
        click: Some("gridcell:Tuesday, June 24, 2025"),
        subject: "heading:Day selected",
        expect: PaintsNamed,
    ),
    (
        id: "restored-contrast-passes",
        group: "restore",
        what: "restoring readable text passes based on the resulting foreground",
        click: Some("button:Restore contrast"),
        subject: "heading:Readable text",
        expect: Contrast,
    ),
    (
        id: "delayed-contrast-passes",
        group: "restore-later",
        what: "contrast waits for the action's rendered result and verifies it stays readable",
        click: Some("button:Restore contrast after transition"),
        subject: "heading:Readable text",
        expect: Contrast,
        stable_for_ms: 150,
        outcome_timeout_ms: 1000,
    ),
    (
        id: "broken-contrast-fails",
        group: "break",
        what: "making previously readable text black on black fails",
        prepare: Some("button:Restore contrast"),
        click: Some("button:Break contrast"),
        subject: "heading:Readable text",
        expect: Contrast,
    ),
]
