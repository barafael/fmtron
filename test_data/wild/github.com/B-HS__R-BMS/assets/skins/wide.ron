// rbms WIDE skin (RON), 1280x720 (16:9). Wider playfield (bigger lanes) with a top frame +
// center live score graph (hud) + smaller right BGA. Same reference space as normal.ron.
(
    field_x: 0.18,
    field_width: 0.36,
    top_y: 60.0,
    judge_y: 620.0,
    note_height: 16.0,
    scratch_left: false,
    lift: 0.0,
    key_color: (235, 235, 235),
    key_color_alt: (70, 130, 230),
    scratch_color: (230, 70, 70),
    mine_color: (70, 220, 120),
    lane_bg: (18, 18, 24),
    lane_bg_alpha: 160,
    judge_line: (200, 40, 40),
    beam_color: (200, 220, 255),
    beam_alpha: 160,
    beam_height_frac: 1.0,
    outline_color: (90, 90, 110),
    outline_alpha: 200,
    divider_color: (60, 60, 75),
    divider_alpha: 150,
    bg: (0, 0, 0),
    bga: Some((920.0, 360.0, 340.0, 255.0)),
)
