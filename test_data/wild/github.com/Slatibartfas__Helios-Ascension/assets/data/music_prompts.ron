// Music generation prompts (MiniMax Music 3.0)
//
// Captures the exact prompts + parameters used to generate the
// AI-authored entries in `src/plugins/music.rs::MusicPlaylist`.
// Keep this file in sync with `MusicPlaylist::default()` so any
// future regeneration produces the same family of tracks.
//
// Generated via: `mmx music generate --instrumental --prompt <...> ...`
// API reference: https://platform.minimax.io/docs/guides/music-generation
//
// Prompt-engineering notes (for any future regeneration):
//   * Use short ambient briefs — mood + 2-3 instrument cues + use case +
//     BPM. Do NOT add Stellaris / Homeworld / Terra Invicta / Mass Effect
//     style references. Those are OST-style references and tip the model
//     into "song with vocals" mode even when the prompt explicitly says
//     "no vocals".
//   * Do NOT add song-structure tags like "intro-verse-chorus-verse-outro".
//     "chorus" especially nudges the model toward vocal hooks.
//   * Always pass `--instrumental` AND `--avoid "vocals, choir, singing,
//     vocal pads, harmony, voice"`. The --avoid flag is honored more
//     reliably than in-prompt negatives once the prompt already reads
//     like a song brief.
//   * Keep BPMs in the 75-100 ambient band; stick to a single mood per
//     prompt (don't mix "triumphant" and "melancholic").

[
    // ── helios-drift.mp3 ────────────────────────────────────
    // Slot: between exploration turns; the quietest, most
    // contemplative track in the playlist.
    (
        track_id: "helios-drift",
        title: "Helios Drift",
        path: "audio/music/helios-drift.mp3",
        attribution: "minimax-music-3.0",
        prompt: "Slow ambient space orchestral, cinematic, atmospheric, vast and contemplative, gentle piano with soft synthesizer pads and distant strings, suitable as background music for a 4X space strategy game during quiet exploration, no vocals, no percussion, 80 BPM",
        use_case: "background music for video",
        bpm: 80,
        key: "D minor",
        bitrate: 256000,
        sample_rate: 44100,
        format: "mp3",
    ),

    // ── helios-jovian-rendezvous.mp3 ─────────────────────────
    // Slot: mid-game fleet maneuvers; builds tension without
    // becoming action music.
    (
        track_id: "helios-jovian-rendezvous",
        title: "Helios Jovian Rendezvous",
        path: "audio/music/helios-jovian-rendezvous.mp3",
