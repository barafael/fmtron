AppState(
  schema_version: 4,
  sections: {
    "nav": Nav(NavConfig(
      sections: [
        Section(
          key: "main",
          label: "Main",
          icon: "home",
          roles: None,
          entries: [
            Entry(
              route: "dashboard",
              label: Some("Dashboard"),
              icon: Some("home"),
              roles: None,
            ),
            Entry(
              route: "profile",
              label: Some("Profile"),
              icon: Some("user"),
              roles: None,
            ),
          ],
        ),
        Section(
          key: "admin",
          label: "Admin",
          icon: "bolt",
          roles: Some([Admin]),
          entries: [
            Entry(
              route: "admin",
              label: Some("Overview"),
              icon: Some("activity"),
              roles: Some([Admin]),
            ),
          ],
        ),
      ],
    )),
    "pages": Pages([
      Page(
        route: "dashboard",
        path: "/dashboard",
        component: "dashboard:DashboardPage",
        layout: Cards,
        label: Some("Dashboard"),
        icon: None,
        in_nav: true,
        roles: None,
      ),
      Page(
        route: "profile",
        path: "/profile",
