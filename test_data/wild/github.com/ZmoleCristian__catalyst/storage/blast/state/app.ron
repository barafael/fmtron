      Page(
        route: "admin",
        path: "/admin",
        component: "admin:AdminPage",
        layout: Bleed,
        label: Some("Admin"),
        icon: None,
        in_nav: false,
        roles: Some([Admin]),
      ),
    ]),
    "sync": Sync(SyncConfig(
      // Project-root-relative paths that `blast sync` will not overwrite.
      // A directory entry freezes everything beneath it; a file entry freezes that file.
      // Run `blast sync diff` to see drift between frozen entries and what catalyst currently ships.
      freeze: [],
    )),
  },
