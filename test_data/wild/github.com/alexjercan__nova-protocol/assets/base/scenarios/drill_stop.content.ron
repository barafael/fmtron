                            color: Srgba((
                                red: 0.3,
                                green: 0.9,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            area_radius: Some(100.0),
                        )),
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "mark_bravo",
                        label: "BRAVO",
                    )),
                    CreateScenarioArea((
                        id: "mark_bravo_gate",
                        name: "BRAVO Gate",
                        position: (
                            350.0,
                            0.0,
                            -900.0,
                        ),
                        rotation: (
                            0.0,
                            0.0,
                            0.0,
                            1.0,
                        ),
                        radius: 100.0,
                    )),
                    Objective((
                        id: "slide",
                        message: "Use RCS to move onto mark BRAVO.",
                    )),
                    HintEmphasisSet((
                        verb: "RCS",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "Stopped. Now use the RCS thrusters: they move the ship sideways without turning it. Move onto mark BRAVO.",
                    )),
                ],
            ),
            (
                name: OnEnter,
                once: true,
                filters: [
                    Entity((
                        id: Some("mark_bravo_gate"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(3.0)))),
                    ))),
                ],
                actions: [
                    HintEmphasisClear((
                        verb: "RCS",
                    )),
                    ObjectiveMarkerDetach((
                        target_id: "mark_bravo",
                    )),
                    DespawnScenarioObject((
                        id: "mark_bravo",
                    )),
                    DespawnScenarioObject((
                        id: "mark_bravo_gate",
                    )),
                    ObjectiveComplete((
                        id: "slide",
                    )),
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(90.0)))),
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "Both marks done. You stopped the ship with STOP and placed it with RCS.",
                    )),
                    Sequence((
                        key: "drill_outro",
                        steps: [
                            (
                                after: Some(3.0),
                                actions: [
                                    Outcome((
                                        outcome: Victory,
                                        message: Some("STOP practice complete."),
                                    )),
                                ],
                            ),
                        ],
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("trainer"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(90.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship was destroyed. Starting again."),
                    )),
                    NextScenario((
                        scenario_id: "drill_stop",
                        linger: true,
                    )),
                ],
            ),
            (
                name: OnNeutralized,
                once: true,
                filters: [
                    Entity((
                        id: Some("trainer"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(90.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship was destroyed. Starting again."),
                    )),
                    NextScenario((
                        scenario_id: "drill_stop",
                        linger: true,
                    )),
                ],
            ),
        ],
    )),
