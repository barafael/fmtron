                                red: 0.3,
                                green: 0.9,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            area_radius: Some(300.0),
                        )),
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "mark_alpha",
                        label: "ALPHA",
                    )),
                    CreateScenarioArea((
                        id: "mark_alpha_gate",
                        name: "ALPHA Gate",
                        position: (
                            0.0,
                            0.0,
                            -900.0,
                        ),
                        rotation: (
                            0.0,
                            0.0,
                            0.0,
                            1.0,
                        ),
                        radius: 300.0,
                    )),
                    Objective((
                        id: "rest",
                        message: "Stop on mark ALPHA.",
                    )),
                    HintEmphasisSet((
                        verb: "STOP",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "Fly out to mark ALPHA and stop on it. STOP hands the ship to the flight computer, which turns the ship around and thrusts until your speed reads zero.",
                    )),
                ],
            ),
            (
                name: OnEnter,
                once: true,
                filters: [
                    Entity((
                        id: Some("mark_alpha_gate"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(2.0)))),
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "You are on the mark but still moving. Use STOP and let the flight computer take your speed down to zero.",
                    )),
                ],
            ),
            (
                name: OnStopComplete,
                once: true,
                filters: [
                    Entity((
                        id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(2.0)))),
                    ))),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "rest",
                    )),
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(3.0)))),
                    )),
                    HintEmphasisClear((
                        verb: "STOP",
                    )),
                    ObjectiveMarkerDetach((
                        target_id: "mark_alpha",
                    )),
                    DespawnScenarioObject((
                        id: "mark_alpha",
                    )),
                    DespawnScenarioObject((
                        id: "mark_alpha_gate",
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "mark_bravo",
                            name: "BRAVO",
                            position: (
                                350.0,
                                0.0,
