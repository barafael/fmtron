                            allegiance: Some(Neutral),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "transport_a",
                            name: "Transport 1",
                            position: (-450.0, 0.0, -600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            design: Prototype(id: "ledger_freighter"),
                            controller: None,
                            allegiance: Some(Player),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "transport_b",
                            name: "Transport 2",
                            position: (450.0, 100.0, -600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            design: Prototype(
                                id: "racer",
                                section_patches: {
                                    "fuselage": (config: (health: Some(1000.0))),
                                    "engine_port": (config: (health: Some(300.0))),
                                    "engine_starboard": (config: (health: Some(300.0))),
                                },
                            ),
                            controller: None,
                            allegiance: Some(Player),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "dock",
                            name: "Cargo dock",
                            position: (0.0, -100.0, -9500.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            design: Prototype(id: "ledger_platform"),
                            controller: None,
                            allegiance: Some(Neutral),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "escort",
                            name: "Escort",
                            position: (-1100.0, 350.0, 2000.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            design: Prototype(id: "cargoa"),
                            controller: AI((
                                engage_delay: Some(10.0),
                                standoff_clearance: Some(1250.0),
                                engage_range: Some(3000.0),
                                leash: Some(6500.0),
                                patrol: [
                                    (-1100.0, 350.0, 2000.0),
                                    (-1000.0, 350.0, -1200.0),
                                    (-750.0, 350.0, -3800.0),
                                ],
                            )),
                            allegiance: Some(Player),
                        )),
                    )),
                    Objective((
                        id: "convoy",
                        message: "Cross DEPARTURE, then screen both transports through the debris lane.",
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "departure",
                            name: "DEPARTURE",
                            position: (0.0, 0.0, -1000.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Beacon((
                            label: "DEPARTURE",
                            radius: 20.0,
                            color: Srgba((red: 0.25, green: 0.9, blue: 1.0, alpha: 1.0)),
                            area_radius: Some(700.0),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "dock_mark",
                            name: "DOCK",
                            position: (0.0, 300.0, -9000.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Beacon((
                            label: "DOCK",
                            radius: 20.0,
                            color: Srgba((red: 0.25, green: 0.9, blue: 1.0, alpha: 1.0)),
                            area_radius: Some(700.0),
                        )),
                    )),
                    HudReadout((
                        slot: "arrived",
                        variable: "arrived",
                        format: Integer,
                        label: Some("DOCKED"),
                        visible: true,
                    )),
                    CinematicTitle((
                        corner: TopRight,
                        location: "FREIGHT LANE",
                        date: "FIELD TRIAL 5 / 6",
                        note: "",
                        seconds: 5.0,
                    )),
                ],
            ),
            (
                name: OnEnter,
                once: true,
                filters: [
                    Entity((id: Some("departure"), other_id: Some("player_spaceship"))),
                    Expression((Equal(Term(Factor(Name("stage"))), Term(Factor(Literal(Number(0.0))))))),
                ],
                actions: [
                    DespawnScenarioObject((id: "departure")),
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(1.0)))))),
                    ObjectiveMarkerAttach((target_id: "transport_a", label: "TRANSPORT 1")),
                    ObjectiveMarkerAttach((target_id: "transport_b", label: "TRANSPORT 2")),
                    MoveShipTo((
                        ship: "transport_a",
                        order: "a_mid",
                        position: (-700.0, 0.0, -4200.0),
                        arrival_standoff: Some(80.0),
                    )),
                    MoveShipTo((
                        ship: "transport_b",
                        order: "b_mid",
                        position: (700.0, 100.0, -4300.0),
                        arrival_standoff: Some(80.0),
                    )),
                    TimerStart((key: "convoy_limit", seconds: Term(Factor(Literal(Number(240.0)))))),
                    Sequence((
                        key: "first_intercept",
                        steps: [
                            (
                                after: Some(3.0),
                                actions: [
                                    SpawnScenarioObject((
                                        base: (
                                            id: "interceptor_a",
                                            name: "Interceptor 1",
                                            position: (-900.0, 200.0, -3600.0),
                                            rotation: (0.0, 0.0, 0.0, 1.0),
                                        ),
                                        kind: Spaceship((
                                            design: Prototype(id: "cargoa_raider"),
                                            controller: AI((
                                                engage_delay: Some(5.0),
                                                standoff_clearance: Some(1250.0),
                                                engage_range: Some(4400.0),
                                            )),
                                            allegiance: Some(Enemy),
                                        )),
                                    )),
                                    SpawnScenarioObject((
                                        base: (
                                            id: "interceptor_b",
                                            name: "Interceptor 2",
                                            position: (900.0, -150.0, -4300.0),
                                            rotation: (0.0, 0.0, 0.0, 1.0),
                                        ),
                                        kind: Spaceship((
                                            design: Prototype(id: "cargoa_raider"),
                                            controller: AI((
                                                engage_delay: Some(5.0),
                                                standoff_clearance: Some(1250.0),
                                                engage_range: Some(4400.0),
                                            )),
                                            allegiance: Some(Enemy),
                                        )),
                                    )),
                                ],
                            ),
                        ],
                    )),
                ],
            ),
            (
                name: OnShipOrderComplete,
                once: true,
                filters: [ShipOrder((order: Some("a_mid")))],
                actions: [
                    MoveShipTo((
                        ship: "transport_a",
                        order: "a_late",
                        position: (-650.0, 0.0, -6700.0),
                        arrival_standoff: Some(80.0),
                    )),
                ],
            ),
            (
                name: OnShipOrderComplete,
                once: true,
                filters: [ShipOrder((order: Some("b_mid")))],
                actions: [
                    MoveShipTo((
                        ship: "transport_b",
                        order: "b_late",
                        position: (650.0, 100.0, -6800.0),
                        arrival_standoff: Some(80.0),
                    )),
                ],
            ),
            (
                name: OnShipOrderComplete,
                once: true,
                filters: [ShipOrder((order: Some("a_late")))],
                actions: [
                    MoveShipTo((
                        ship: "transport_a",
                        order: "a_dock",
                        position: (-350.0, 0.0, -8900.0),
                        arrival_standoff: Some(80.0),
                    )),
                ],
            ),
            (
                name: OnShipOrderComplete,
                once: true,
                filters: [ShipOrder((order: Some("b_late")))],
                actions: [
                    MoveShipTo((
                        ship: "transport_b",
                        order: "b_dock",
                        position: (350.0, 100.0, -8900.0),
                        arrival_standoff: Some(80.0),
                    )),
                ],
            ),
            (
                name: OnShipOrderComplete,
                once: true,
                filters: [ShipOrder((order: Some("a_dock")))],
                actions: [
                    VariableSet((
                        key: "arrived",
                        expression: Add(Factor(Name("arrived")), Term(Factor(Literal(Number(1.0))))),
                    )),
                    ObjectiveMarkerDetach((target_id: "transport_a")),
                ],
            ),
            (
                name: OnShipOrderComplete,
                once: true,
                filters: [ShipOrder((order: Some("b_dock")))],
                actions: [
                    VariableSet((
                        key: "arrived",
                        expression: Add(Factor(Name("arrived")), Term(Factor(Literal(Number(1.0))))),
                    )),
                    ObjectiveMarkerDetach((target_id: "transport_b")),
                ],
            ),
            (
                name: OnUpdate,
                once: true,
                filters: [
                    Expression((GreaterThan(Term(Factor(Name("arrived"))), Term(Factor(Literal(Number(1.0))))))),
                    Expression((Equal(Term(Factor(Name("stage"))), Term(Factor(Literal(Number(1.0))))))),
                ],
                actions: [
                    TimerCancel((key: "convoy_limit")),
                    ObjectiveComplete((id: "convoy")),
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(99.0)))))),
                    Outcome((outcome: Victory, message: Some("Both transports docked."))),
                    NextScenario((scenario_id: "ledger_06_siege_line", linger: true)),
                ],
            ),
            (
                name: OnTimerEnd,
                once: true,
                filters: [
                    Timer((key: "convoy_limit")),
                    Expression((Equal(Term(Factor(Name("stage"))), Term(Factor(Literal(Number(1.0))))))),
                ],
                actions: [
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(98.0)))))),
                    Outcome((outcome: Defeat, message: Some("The convoy could not reach its berths."))),
                    NextScenario((scenario_id: "ledger_05_freight_lane", linger: true)),
                ],
            ),
            (
                name: OnDefeated,
                once: true,
                filters: [
                    Entity((id: Some("transport_a"))),
                    Expression((LessThan(Term(Factor(Name("stage"))), Term(Factor(Literal(Number(98.0))))))),
                ],
                actions: [
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(98.0)))))),
                    Outcome((outcome: Defeat, message: Some("Transport 1 lost."))),
                    NextScenario((scenario_id: "ledger_05_freight_lane", linger: true)),
                ],
            ),
            (
                name: OnDefeated,
                once: true,
                filters: [
                    Entity((id: Some("transport_b"))),
                    Expression((LessThan(Term(Factor(Name("stage"))), Term(Factor(Literal(Number(98.0))))))),
                ],
                actions: [
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(98.0)))))),
                    Outcome((outcome: Defeat, message: Some("Transport 2 lost."))),
                    NextScenario((scenario_id: "ledger_05_freight_lane", linger: true)),
                ],
            ),
            (
                name: OnDefeated,
                once: true,
                filters: [
                    Entity((id: Some("player_spaceship"))),
                    Expression((LessThan(Term(Factor(Name("stage"))), Term(Factor(Literal(Number(98.0))))))),
                ],
                actions: [
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(98.0)))))),
                    Outcome((outcome: Defeat, message: Some("Ship disabled."))),
                    NextScenario((scenario_id: "ledger_05_freight_lane", linger: true)),
                ],
            ),
        ],
    )),
]
