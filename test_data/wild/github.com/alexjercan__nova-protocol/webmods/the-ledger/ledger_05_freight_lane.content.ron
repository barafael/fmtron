                    ScatterObjects((
                        id_prefix: "lower_rocks_",
                        count: 14,
                        seed: 8534,
                        region: Box(min: (-1300.0, -1250.0, -8000.0), max: (1300.0, -900.0, -1800.0)),
                        template: (
