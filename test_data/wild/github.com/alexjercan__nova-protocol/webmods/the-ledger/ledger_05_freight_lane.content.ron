                    ScatterObjects((
                        id_prefix: "lane_cluster_",
                        count: 12,
                        seed: 8544,
                        region: Box(min: (-1300.0, -600.0, -7800.0), max: (1300.0, 700.0, -2200.0)),
                        template: (
                            base: (
                                id: "lane_cluster_",
                                name: "Asteroid",
                                position: (0.0, 0.0, 0.0),
