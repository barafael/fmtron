                        kind: Spaceship((
                            design: Prototype(
                                id: "cargoa",
                                section_patches: {
                                    "fuselage": (config: (health: Some(1200.0))),
                                    "engine_port": (config: (health: Some(300.0))),
                                    "engine_starboard": (config: (health: Some(300.0))),
                                    "nose": (config: (health: Some(1200.0))),
                                },
                            ),
                            controller: Player((
                                input_mapping: {"turret_port": [Mouse(Left), Gamepad(RightTrigger2)], "turret_starboard": [Mouse(Left), Gamepad(RightTrigger2)]},
                            )),
                            allegiance: Some(Player),
                        )),
                    )),
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(0.0)))))),
