                        kind: Light(Directional(illuminance: 16000.0, color: Srgba((red: 0.55, green: 0.7, blue: 1.0, alpha: 1.0)), shadows: false, aim: Some((0.0, 0.0, -2500.0)))),
                    )),
                    SpawnScenarioObject((
