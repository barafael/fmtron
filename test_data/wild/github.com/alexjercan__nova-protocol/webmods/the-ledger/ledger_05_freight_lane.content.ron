// Freight Lane: independent activity; no carried campaign state.
// Flight is live from spawn. A seeded central cluster adds corridor depth.
[
    Scenario((
        id: "ledger_05_freight_lane",
        name: "Freight Lane",
        description: "Screen two transports through a hostile debris lane.",
        cubemap: "dep://base/textures/cubemap_alt.png",
        thumbnail: Some("self://thumbnails/ledger_05_freight_lane.png"),
        watches: [(variable: "elapsed", query: Scenario((property: Elapsed)))],
        events: [
            (
                name: OnStart,
                once: true,
                filters: [],
                actions: [
                    SpawnScenarioObject((
                        base: (
                            id: "player_spaceship",
                            name: "Corvette",
