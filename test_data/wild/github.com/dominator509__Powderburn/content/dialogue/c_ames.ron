[
  (id:"dlg_ames_a1",act:1,node_id:Some("camp_03_eastbound"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_ames"],max_ledger_weight:None,lines:[(speaker_id:"c_ames",language:"en",original:"A private badge is still a badge. I learned too late how easily clients rent the law.",translation:None,subtitle:"Ames says private clients can rent the authority of a badge.")]),
