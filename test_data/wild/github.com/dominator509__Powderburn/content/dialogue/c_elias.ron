[
  (id:"dlg_elias_a1",act:1,node_id:Some("camp_01_ledger_fire"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_elias"],max_ledger_weight:None,lines:[(speaker_id:"c_elias",language:"en",original:"Teague keeps calling this my book. It is not. It belongs to the people he priced, and they may burn it when they are safe.",translation:None,subtitle:"Elias says the evidence belongs to Teague's victims, not to him.")]),
  (id:"dlg_elias_a2",act:2,node_id:Some("camp_06_broken_ties"),requires_flags:["a2_promontory_present"],requires_alive:["c_elias"],max_ledger_weight:Some(20),lines:[(speaker_id:"c_elias",language:"en",original:"The rails make every mile look inevitable after the spikes are driven.",translation:None,subtitle:"Elias says the rails make every mile look inevitable after the spikes are driven.")]),
  (id:"dlg_elias_a3",act:3,node_id:Some("camp_09_four_days_late"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_elias"],max_ledger_weight:None,lines:[(speaker_id:"c_elias",language:"en",original:"Four days late, and the newspapers have already made the dead into an argument.",translation:None,subtitle:"Elias says the newspapers have already made the dead into an argument.")]),
  (id:"dlg_elias_a4",act:4,node_id:Some("camp_12_last_account"),requires_flags:["a4_salt_war_sided_with_ruelas"],requires_alive:["c_elias"],max_ledger_weight:None,lines:[(speaker_id:"c_elias",language:"en",original:"When Teague asks for arithmetic, I will answer with every name in this book.",translation:None,subtitle:"Elias says he will answer Teague with every name in the Ledger.")]),
]
