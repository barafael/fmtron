[
  (id:"dlg_mercer_a1",act:1,node_id:Some("camp_03_eastbound"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_mercer"],max_ledger_weight:Some(10),lines:[(speaker_id:"c_mercer",language:"en",original:"I spent years polishing defeat into a story where I remained honorable.",translation:None,subtitle:"Mercer admits he polished defeat into a story that preserved his honor.")]),
  (id:"dlg_mercer_a2",act:2,node_id:Some("camp_06_broken_ties"),requires_flags:["a2_promontory_present"],requires_alive:["c_mercer"],max_ledger_weight:Some(16),lines:[(speaker_id:"c_mercer",language:"en",original:"A railroad does not care which flag a cavalryman followed. It only asks whether he clears the grade.",translation:None,subtitle:"Mercer says the railroad values what he can clear, not the flag he followed.")]),
  (id:"dlg_mercer_a3",act:3,node_id:Some("camp_07_hide_smoke"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_mercer"],max_ledger_weight:Some(24),lines:[(speaker_id:"c_mercer",language:"en",original:"There is no gallantry in a hide yard. That may be why I finally see it plain.",translation:None,subtitle:"Mercer says the hide yard strips away his stories of gallantry.")]),
  (id:"dlg_mercer_a4",act:4,node_id:Some("camp_12_last_account"),requires_flags:["a4_salt_war_sided_with_ruelas"],requires_alive:["c_mercer"],max_ledger_weight:None,lines:[(speaker_id:"c_mercer",language:"en",original:"Do not write that I was redeemed. Write that I stopped lying before the end.",translation:None,subtitle:"Mercer asks Elias not to call him redeemed, only honest before the end.")]),
]
