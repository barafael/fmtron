[
  (id:"dlg_whitehorse_a1",act:1,node_id:Some("camp_02_winter_count"),requires_flags:["a1_treaty_witnessed"],requires_alive:["c_whitehorse"],max_ledger_weight:None,lines:[(speaker_id:"c_whitehorse",language:"en",original:"A treaty can be signed in one day. Living beneath it takes every day after.",translation:None,subtitle:"Tsayd-tainte says signing a treaty takes one day, but living beneath it takes every day after.")]),
  (id:"dlg_whitehorse_a2",act:2,node_id:Some("camp_04_cinders"),requires_flags:["a2_promontory_present"],requires_alive:["c_whitehorse"],max_ledger_weight:None,lines:[(speaker_id:"c_whitehorse",language:"en",original:"The iron road does not ask whose trail it crosses.",translation:None,subtitle:"Tsayd-tainte says the iron road does not ask whose trail it crosses.")]),
  (id:"dlg_whitehorse_a3",act:3,node_id:Some("camp_09_four_days_late"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_whitehorse"],max_ledger_weight:None,lines:[(speaker_id:"c_whitehorse",language:"en",original:"Do not make one distant battle stand for every Native nation. Name the people who were there.",translation:None,subtitle:"Tsayd-tainte insists that the people at a distant battle be named specifically.")]),
  (id:"dlg_whitehorse_a4",act:4,node_id:Some("camp_11_names_carried"),requires_flags:["a3_adobe_walls_survived"],requires_alive:["c_whitehorse"],max_ledger_weight:None,lines:[(speaker_id:"c_whitehorse",language:"en",original:"At Fort Marion they made prisoners answer to new names. Write the names they carried in.",translation:None,subtitle:"Tsayd-tainte asks Elias to record the prisoners' own names.")]),
