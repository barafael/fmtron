#![enable(implicit_some, unwrap_newtypes, unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    browser_column_widths: [20, 30, 60],
    symbols: (song: "󰎈 ", dir: "󰉋 ", marker: " ", ellipsis: "..."),
    text_color: "#c0caf5",
    tab_bar: (
        enabled: true,
        active_style: (bg: "#1a1b26", fg: "#7aa2f7", modifiers: "Bold"),
        inactive_style: (fg: "#565f89", modifiers: ""),
    ),
    highlighted_item_style: (fg: "#9ece6a", modifiers: "Bold"),
    current_item_style: (fg: "#7aa2f7", bg: "#1a1b26", modifiers: "Bold"),
    borders_style: (fg: "#3b4261", modifiers: "Bold"),
    highlight_border_style: (fg: "#7aa2f7"),
    progress_bar: (
        symbols: ["┄", "┅", "━"],
        track_style: (fg: "#24283b"),
        elapsed_style: (fg: "#7aa2f7"),
        thumb_style: (fg: "#7dcfff"),
    ),
    scrollbar: (
        symbols: ["", "", "", ""],
        track_style: (fg: "#3b4261"),
        ends_style: (fg: "#3b4261"),
        thumb_style: (fg: "#7aa2f7"),
    ),
    browser_song_format: [
        (kind: Group([(kind: Property(Track)), (kind: Text(" "))])),
        (
            kind: Group([(kind: Property(Title)), (kind: Text(" - ")), (kind: Property(Artist))]),
            default: (kind: Property(Filename)),
        ),
    ],
    song_table_format: [
        (
            prop: (
                kind: Property(Title),
                style: (fg: "#7dcfff"),
                highlighted_item_style: (fg: "#1a1b26", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "#565f89")),
            ),
            width: "50%",
        ),
        (
            prop: (
                kind: Property(Artist),
                style: (fg: "#bb9af7"),
                default: (kind: Text("Unknown Artist"), style: (fg: "#565f89")),
            ),
            width: "45%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#ff9e64")),
            width: "10%",
            alignment: Right,
        ),
    ],
    header: (
        rows: [
            (
                left: [(
                    kind: Property(Status(StateV2(playing_label: " 🔊", paused_label: " ❚❚", stopped_label: " ⏹️"))),
                    style: (fg: "#7dcfff", modifiers: "Bold"),
                )],
                center: [(
                    kind: Property(Song(Title)),
                    style: (fg: "#c0caf5", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "#c0caf5", modifiers: "Bold")),
                )],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#ff9e64", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#ff9e64", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#ff9e64", modifiers: "Bold")),
                ],
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#c0caf5")),
                    (kind: Text("/"), style: (fg: "#565f89")),
                    (kind: Property(Status(Duration)), style: (fg: "#c0caf5")),
                ],
                center: [(
                    kind: Property(Song(Artist)),
                    style: (fg: "#bb9af7", modifiers: "Bold"),
                    default: (kind: Text("Unknown Artist"), style: (fg: "#f7768e", modifiers: "Bold")),
                )],
                right: [(
                    kind: Property(Widget(States(
                        active_style: (fg: "#bb9af7", modifiers: "Bold"),
                        separator_style: (fg: "#565f89"),
                    ))),
                    style: (fg: "#565f89"),
                )],
            ),
        ],
    ),
layout: Split(
    direction: Vertical,
    panes: [
        (
            size: "4",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "100%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "4",
                                    borders: "ALL",
                                    pane: Pane(Header),
                                ),
                            ],
                        ),
                    ),
                ],
            ),
        ),
        (
            size: "3",
            pane: Pane(Tabs),
        ),
        (
            size: "100%",
            borders: "NONE",          // ← full width now
            pane: Pane(TabContent),
        ),
        (
            size: "3",
            borders: "TOP | BOTTOM",
            pane: Pane(ProgressBar),
        ),
    ],
),
)
