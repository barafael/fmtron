(
    schema_version: 1,
    authority: PostgresAuthority,
    transport: PostcardHttps,
    official_local_adapters: [SQLiteLocal],
    conditional_local_adapters: [StoolapLocal],
    product_components: [
        RustSdk,
        PostcardHttps,
        Axum,
        PostgresAuthority,
        NeonPostgresProfile,
        SQLiteLocal,
        StoolapLocal,
        DioxusIntegration,
        CliDevtools,
        TestkitConformance,
    ],
    deferred: [
        MultiPrimaryAuthority,
        GenericCrdtFramework,
        PeerToPeerAuthority,
        ConsensusImplementation,
        RuntimePlugins,
        CustomDatabaseEngine,
        CustomTransport,
        UniversalOrm,
        UniversalRowReplication,
        ArbitraryQueryReplication,
    ],
    single_logical_writer: true,
    maximum_official_local_adapters: 2,
)
