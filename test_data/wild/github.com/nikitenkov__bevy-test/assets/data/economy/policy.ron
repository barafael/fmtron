                "fresh_harvest_food",
            ),
        ),
        (
            id: "renewable_raw_food",
            query: SingleConcept(
                "renewable_raw_food",
            ),
        ),
        (
            id: "finite_raw_food",
            query: SingleConcept(
                "finite_raw_food",
            ),
        ),
        (
