// hyprshell — macOS Cmd+Tab style window switcher (2026-08-21)
// Hold SUPER (physical Alt on vic), tap Tab to cycle MRU windows across ALL
// workspaces/monitors (filter_by empty = global, like the Mac), release to pick.
// SUPER+SHIFT+Tab goes backwards; SUPER+q while open kills the highlighted window.
// Overview/launcher intentionally disabled (F3 hyprexpo + omarchy-menu cover that).
(
    version: 4,
    windows: (
        scale: 3.5,
        items_per_row: 8,
        overview: None,
        switch: (
            modifier: "super",
            key: "Tab",
            filter_by: [],
            switch_workspaces: true,
            exclude_workspaces: "",
            kill_key: 'q',
        ),
        switch_2: None,
    ),
)
