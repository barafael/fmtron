// Demo 1: the spine. Scheduled clicks are sample-exact (unit test) and
// detected onsets land within tolerance (verify block + probe).
Score(
    version: 1,
    sample_rate: 48000,
    ppq: 960,
    time_signature: (4, 4),
    tempo: [(tick: 0, bpm: 120.0)],
    tracks: [
        Track(
            name: "click",
            instrument: Preset("noise_hat"),
            notes: [
                Note(at: (1, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (1, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (1, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (1, 4), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (2, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (2, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (2, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (2, 4), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (3, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (3, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (3, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (3, 4), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (4, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (4, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (4, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (4, 4), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (5, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (5, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (5, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (5, 4), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (6, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (6, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (6, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (6, 4), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (7, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (7, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (7, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (7, 4), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (8, 1), dur: "1/16", pitch: "A4", vel: 110),
                Note(at: (8, 2), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (8, 3), dur: "1/16", pitch: "A4", vel: 85),
                Note(at: (8, 4), dur: "1/16", pitch: "A4", vel: 85),
            ],
        ),
    ],
    verify: [
        // The t=0 click gets a wider tolerance: an onset at sample 0 has no
        // preceding STFT frame, so the earliest reportable frame-center is
        // fft/2 + hop ≈ 16 ms at 48 kHz. Interior clicks hold ±10 ms.
        OnsetAt(track: "click", at: (1, 1), tol_ms: 20.0),
        OnsetAt(track: "click", at: (3, 2), tol_ms: 10.0),
        OnsetAt(track: "click", at: (5, 1), tol_ms: 10.0),
        OnsetAt(track: "click", at: (8, 4), tol_ms: 10.0),
        TruePeakBelow(dbtp: -1.0),
        SilentAfter(at: (9, 1)),
    ],
)
