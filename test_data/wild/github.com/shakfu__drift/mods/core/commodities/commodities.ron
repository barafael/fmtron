// Base commodities. `base_price` is the price at equilibrium stock; `elasticity`
// controls how sharply price reacts to surplus/shortage.
//
// Two goods are `illegal`. That is the whole smuggling axis: they are worth what
// they are worth *because* carrying them is a crime, and a police scan in a
// well-governed system confiscates them and puts a bounty on your head. A cargo
// of narcotics is worth most exactly where it is most likely to be found.
[
    (id: "core:food",      name: "Food",      base_price: 20,  unit_mass: 1, elasticity: 0.7, category: "food"),
    (id: "core:ore",       name: "Ore",       base_price: 30,  unit_mass: 2, elasticity: 0.8, category: "minerals"),
    (id: "core:alloys",    name: "Alloys",    base_price: 80,  unit_mass: 2, elasticity: 0.8, category: "minerals"),
    (id: "core:machinery", name: "Machinery", base_price: 200, unit_mass: 3, elasticity: 0.9, category: "industrial"),
    (id: "core:luxuries",  name: "Luxuries",  base_price: 400, unit_mass: 1, elasticity: 1.0, category: "luxury"),

    // Contraband. High margin, high elasticity, and a criminal record if you are
    // caught with it.
    (id: "core:narcotics", name: "Narcotics", base_price: 700, unit_mass: 1, elasticity: 1.3, category: "contraband", illegal: true),
    (id: "core:firearms",  name: "Firearms",  base_price: 550, unit_mass: 2, elasticity: 1.1, category: "contraband", illegal: true),
]
