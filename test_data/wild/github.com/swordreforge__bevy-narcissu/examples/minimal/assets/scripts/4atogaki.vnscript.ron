),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……到底，有什么事呢？",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "首先，已经几乎没有人来问那孩子的事了况且过了这么长时间了，心里也很难有头绪。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不好意思……我姓莳绘……」",
voice: Some("li/4syuji_010"),
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……莳绘先生？」",
