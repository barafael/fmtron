),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，担任医院的医疗部长」",
voice: Some("li/4syuji_011"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "听到这里，就和之前的事联系上了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "因为莳绘这个独特的姓氏，只能联想到她。她的父亲，听说也是那个医院的工作人员。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "……大概这个人，是她的父亲，是为了她女儿来的吧。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "从那之后她几乎每天都来家里，如果是这个年纪的女儿的父亲，会担心也不难理解。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "正那么想着……",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "非常意外地，这个人说的话却有点出乎意料。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「实际上，我和您家的女儿有过约定……」",
voice: Some("li/4syuji_012"),
),
),
(
cmd: label,
args: (
name: "block_00031",
),
),
(
cmd: wait,
args: (
time_ms: 400,
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「……女儿……是说我们家那孩子，濑津美吗？」",
