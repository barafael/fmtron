),
),
(
cmd: label,
args: (
name: "block_00063",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "她坐到沙发上，也让我坐下。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00064",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「其实我啊，以前也担任过陪护喔」",
voice: Some("li/hime1_0122"),
),
),
(
cmd: label,
args: (
name: "block_00065",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉？…在这里？」",
