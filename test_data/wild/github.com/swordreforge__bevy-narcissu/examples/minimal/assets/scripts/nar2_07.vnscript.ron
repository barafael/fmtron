(
cmd: dialogue,
args: (
speaker: None,
text: "冷清的谈话室。\n边看着电视里播的无聊的午间新闻边吃着午餐。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00002",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯~，这个可乐饼果然很好吃呢」",
voice: Some("li/hime1_0105"),
),
),
(
cmd: label,
args: (
name: "block_00003",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "今天，姬子也似乎还是很想要我的便当里的配菜。\n我能理解，毕竟医院的午餐确实不怎么好吃。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00004",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "所以，我把放在桌子上的便当，和姬子的医院指定用餐放在一起，二个人一起吃。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00005",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，这次我想要蔬菜馅的可乐饼」",
voice: Some("li/hime1_0106"),
),
),
(
cmd: label,
args: (
name: "block_00006",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…右边那个」",
voice: Some("li/setsumi_0088"),
),
),
(
cmd: label,
args: (
name: "block_00007",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「好~，谢谢濑津美博士」",
voice: Some("li/hime1_0107"),
),
),
(
cmd: label,
args: (
name: "block_00008",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/setsumi_0127"),
),
),
(
cmd: label,
args: (
name: "block_00009",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…再也不告诉你了」",
voice: Some("li/setsumi_0090"),
),
),
(
cmd: label,
args: (
name: "block_00010",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「啊，开玩笑的啦，开玩笑」",
voice: Some("li/hime1_0108"),
),
),
(
cmd: label,
args: (
name: "block_00011",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这么对话着，正要结束今天的用餐之时。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00012",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那个，从之前我就有些在意…」",
voice: Some("li/hime1_0109"),
),
),
(
cmd: label,
args: (
name: "block_00013",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…难不成你不喜欢吗？」",
voice: Some("li/hime1_0110"),
),
),
(
cmd: label,
args: (
name: "block_00014",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "姬子一边说着，指了指放在便当里的土豆。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00015",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「结果，昨天也是我一个人把土豆全部吃完的不是吗？」",
voice: Some("li/hime1_0111"),
),
),
(
cmd: label,
args: (
name: "block_00016",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/setsumi_0127"),
),
),
(
cmd: label,
args: (
name: "block_00017",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯……讨厌…」",
voice: Some("li/setsumi_0092"),
),
),
(
cmd: label,
args: (
name: "block_00018",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「那么，为什么会放进来？」",
voice: Some("li/hime1_0112"),
),
),
(
cmd: label,
args: (
name: "block_00019",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「………………」",
voice: Some("li/setsumi_0091"),
),
),
(
cmd: label,
args: (
name: "block_00020",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "我不知该如何回答，稍微烦恼一下后…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00021",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "还是老老实实的说出来了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00022",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「以为我是喜欢的…妈妈她…」",
voice: Some("li/setsumi_0093"),
),
),
(
cmd: label,
args: (
name: "block_00023",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉~，你也挺辛苦的呢~」",
voice: Some("li/hime1_0113"),
),
),
(
cmd: label,
args: (
name: "block_00024",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "恐怕，光是这样就能她就能明白这是什么意思了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00025",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "以前的校服也是一样，不知道为什么姬子她，好像总是能看穿我想的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00026",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，姬子说出的下一句话，和之前开朗的语调不同。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00027",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「不过…这可不是温柔喔」",
voice: Some("li/hime1_0114"),
),
),
(
cmd: label,
args: (
name: "block_00028",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「唉？」",
voice: Some("li/setsumi_0094"),
),
),
(
cmd: label,
args: (
name: "block_00029",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「现在的你大概还不能够理解的吧…」",
voice: Some("li/hime1_0115"),
),
),
(
cmd: label,
args: (
name: "block_00030",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「如果你觉得这是在为对方着想的话，可是大错特错呢」",
