),
),
(
cmd: label,
args: (
name: "block_00073",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过，就算在这之中姬子也是最特别的。\n就好像是被允许做任何自己想做的事情。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00074",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "比如我之前就一直疑惑的，比如擅自在花坛种植花朵，还有不需要陪护的事情…",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00075",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "莫名和医生护士的关系很好的事也能解释了。",
