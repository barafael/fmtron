),
),
(
cmd: label,
args: (
name: "block_00078",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…为什么会担任陪护？」",
voice: Some("li/setsumi_0099"),
),
),
(
cmd: label,
args: (
name: "block_00079",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这次我把疑问说了出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00080",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "就算姬子曾经是陪护，不过，为什么会做这样的义工，无法想象出来。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00081",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "至少，自己所知道的姬子，感觉和义工以及陪护这样的东西是无缘的",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00082",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「因为是天主教信徒的关系吧…」",
voice: Some("li/hime1_0124"),
),
),
(
cmd: label,
args: (
name: "block_00083",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「…天主教信徒？」",
voice: Some("li/setsumi_0100"),
),
),
(
cmd: label,
args: (
name: "block_00084",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「嗯，我的父母都是，也会常常参加像是这样的公益活动」",
voice: Some("li/hime1_0125"),
),
),
(
cmd: label,
args: (
name: "block_00085",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这样的回答，让我更加意外。",
