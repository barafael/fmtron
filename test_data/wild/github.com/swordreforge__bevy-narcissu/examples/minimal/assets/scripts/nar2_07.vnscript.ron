),
),
(
cmd: label,
args: (
name: "block_00087",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "不过即使如此，比起刚才说的陪护，这与姬子给我的印象也还是相差得更远了。",
voice: None,
),
),
(
cmd: label,
args: (
name: "block_00088",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「而且你想一下，这是天主教的教会医院对吧？」",
