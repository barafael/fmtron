),
),
(
cmd: label,
args: (
name: "block_00090",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "「所以…就更是如此了啊…」",
voice: Some("li/hime1_0127"),
),
),
(
cmd: label,
args: (
name: "block_00091",
),
),
(
cmd: dialogue,
args: (
speaker: None,
text: "这种说法就好像这是所有问题的答案一样。",
