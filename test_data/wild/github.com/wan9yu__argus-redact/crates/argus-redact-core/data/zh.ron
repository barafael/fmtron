// Chinese pattern data (SSOT). Mirrors lang/zh/patterns.py PATTERNS.
[
    PatternData(
        type_: r"phone",
        label: r"[手机号已脱敏]",
        pattern: r"(?<![0-9])(?:\+86)?1[3-9]\d(?:[\s-]?\d){8}(?![0-9])",
        check_context: true,
        description: r"Chinese mobile phone number (with optional spaces/dashes)",
        language_neutral: true,
    ),
    PatternData(
        type_: r"phone",
        label: r"[电话号已脱敏]",
        pattern: r"(?<![0-9])0[1-9]\d{1,2}-?\d{7,8}(?![0-9])",
        description: r"Chinese landline phone number",
        language_neutral: true,
    ),
    PatternData(
        type_: r"id_number",
        label: r"[身份证号已脱敏]",
        pattern: r"(?<![0-9])[1-9]\d{5}[\s-]?(?:19|20)\d{2}[\s-]?(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])[\s-]?\d{3}[\dXx](?![0-9])",
        validator: Some(r"gb11643_mod11"),
        description: r"Chinese 18-digit national ID (MOD 11-2)",
        language_neutral: true,
    ),
    PatternData(
        type_: r"id_number",
        label: r"[身份证号已脱敏]",
        pattern: r"(?<![0-9])[1-9]\d{5}(?:[2-9]\d)(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])\d{3}(?![0-9])",
        description: r"Chinese 15-digit national ID (pre-1999, no checksum)",
        language_neutral: true,
    ),
    PatternData(
        type_: r"hk_id",
        label: r"[HKID-REDACTED]",
        pattern: r"(?<![A-Z])[A-Z]{1,2}\d{6}\((?:\d|X)\)",
        validator: Some(r"hkid"),
        description: r"Hong Kong Identity Card (1-2 letter + 6 digit + parenthesized check, mod-11)",
    ),
    PatternData(
        type_: r"tw_id",
        label: r"[TWID-REDACTED]",
        pattern: r"(?<![A-Za-z0-9])[A-Z]\d{9}(?![0-9])",
        validator: Some(r"twid"),
        description: r"Taiwan (ROC) national ID (1 letter + 9 digits, weighted mod-10)",
    ),
    PatternData(
        type_: r"macau_id",
        label: r"[MACAU-ID-REDACTED]",
        pattern: r"(?<![0-9])[1-9]/\d{6}/\d(?![0-9])",
        description: r"Macau Resident ID Card — format-only (no public check-digit algorithm)",
    ),
    PatternData(
        type_: r"taiwan_arc",
        label: r"[ARC-REDACTED]",
        pattern: r"(?<![A-Za-z0-9])[A-Z]{2}\d{8}(?![0-9])",
        description: r"Taiwan Alien Resident Certificate (post-2020 LL+8-digit format)",
    ),
    PatternData(
        type_: r"bank_card",
        label: r"[银行卡号已脱敏]",
        pattern: r"(?<![0-9])[3-6]\d{3}(?:[\s-]?\d{4}){2,3}[\s-]?\d{1,4}(?![0-9])",
        validator: Some(r"cn_bank_card"),
        check_context: true,
        description: r"Bank card number (16-19 digits, optional spaces/dashes, Luhn or BIN prefix)",
    ),
    PatternData(
        type_: r"passport",
        label: r"[护照号已脱敏]",
        pattern: r"(?:护照\s*(?:号[码]?\s*)?[:：]?\s*)(?P<passport>[A-Z]\d{8})(?![0-9])",
        group: Some(r"passport"),
        description: r"Chinese passport number (keyword-triggered, reduces false positives)",
    ),
    PatternData(
        type_: r"license_plate",
        label: r"[车牌号已脱敏]",
        pattern: r"[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤川青藏琼宁][A-Z][·.]?[A-Z0-9]{5,6}",
        description: r"Chinese license plate (normal + new energy)",
    ),
    PatternData(
        type_: r"address",
        label: r"[地址已脱敏]",
        pattern: r"(?:[\u4e00-\u9fff]?(?:住在|位于|在|去|从|到))?(?P<address>(?:(?:(?:河北|山西|辽宁|吉林|黑龙江|江苏|浙江|安徽|福建|江西|山东|河南|湖北|湖南|广东|海南|四川|贵州|云南|陕西|甘肃|青海|台湾)省|(?:内蒙古|广西|西藏|宁夏|新疆)(?:自治区)?)[\u4e00-\u9fff]{2,6}(?:市|州)|(?:北京市|天津市|上海市|重庆市|[\u4e00-\u9fff]{2,5}(?:市|州)))[\u4e00-\u9fff]{1,8}(?:区|县|市|旗|新区)[\u4e00-\u9fff]{1,20}(?:路|街|道|巷|里|弄|村)(?:\d{1,5}(?:号|弄))?(?:\d{1,3}(?:栋|幢|楼|座))?(?:\d{1,4}(?:室|房))?)",
        group: Some(r"address"),
        description: r"Chinese structured address (city+district+street+number)",
    ),
    PatternData(
        type_: r"address",
        label: r"[地址已脱敏]",
        pattern: r"(?:朝阳|海淀|东城|西城|丰台|通州|大兴|昌平|顺义|房山|浦东|黄浦|徐汇|静安|长宁|虹口|杨浦|闵行|宝山|嘉定|天河|越秀|海珠|白云|番禺|荔湾|黄埔|花都|增城|从化|南山|福田|罗湖|宝安|龙岗|龙华|盐田|坪山|光明|西湖|上城|拱墅|滨江|萧山|余杭|临平|钱塘|富阳|武侯|锦江|青羊|金牛|成华|龙泉驿|新都|温江|双流|鼓楼|玄武|建邺|秦淮|栖霞|江宁|雨花台|浦口|六合|武昌|洪山|江汉|汉阳|青山|江岸|硚口|东西湖|蔡甸)[\u4e00-\u9fff]{1,20}(?:路|街|道|大道|大街)(?:\d{1,5}(?:号|弄))?(?:\d{1,3}(?:栋|幢|楼|座))?(?:\d{1,4}(?:室|房))?",
        description: r"Informal Chinese address (district+street, no city prefix)",
    ),
    PatternData(
        type_: r"qq",
        label: r"[QQ号已脱敏]",
        pattern: r"[Qq]{2}\s*(?:[:：是]?\s*)(?P<qq>[1-9]\d{4,11})(?![0-9])",
        group: Some(r"qq"),
        description: r"QQ number (5-12 digits, requires QQ keyword context)",
    ),
    PatternData(
        type_: r"wechat",
        label: r"[微信号已脱敏]",
        pattern: r"(?:微信|wx|WeChat|wechat)\s*(?:号)?\s*[:：]?\s*(?P<wechat>[a-zA-Z][a-zA-Z0-9_\-]{5,19})",
        group: Some(r"wechat"),
        description: r"WeChat ID (letter-start, 6-20 chars, requires keyword context)",
    ),
    PatternData(
        type_: r"credit_code",
        label: r"[信用代码已脱敏]",
        pattern: r"(?<![A-Za-z0-9])[0-9A-HJ-NP-RTUW-Ya-hj-np-rtuw-y]{2}\d{6}[0-9A-HJ-NP-RTUW-Ya-hj-np-rtuw-y]{10}(?![A-Za-z0-9])",
        validator: Some(r"credit_code_mod31"),
        description: r"Unified Social Credit Code (GB 32100-2015, MOD 31)",
    ),
    PatternData(
        type_: r"date_of_birth",
        label: r"[出生日期已脱敏]",
        pattern: r"(?:出生日期|出生|生日|生于|born)\s*(?:[:：是]?\s*)(?P<date_of_birth>(?:(?:19|20)\d{2}|[0-9]{2})年(?:0?[1-9]|1[0-2])月(?:(?:0?[1-9]|[12]\d|3[01])(?:日|号))?|(?:十[一二]|[一二三四五六七八九十])月(?:(?:二?十)?[一二三四五六七八九](?:日|号))?|(?:19|20)\d{2}[-/.](?:0[1-9]|1[0-2])[-/.](?:0[1-9]|[12]\d|3[01])|(?:0[1-9]|1[0-2])/(?:0[1-9]|[12]\d|3[01])/(?:19|20)\d{2})",
        group: Some(r"date_of_birth"),
        description: r"Chinese date of birth (keyword-triggered, multiple formats)",
    ),
    PatternData(
        type_: r"military_id",
        label: r"[军官证号已脱敏]",
        pattern: r"(?:军字第|武字第|士兵证号?|义务兵证号?)\s*(?P<military_id>\d{8})(?:号)?",
        group: Some(r"military_id"),
        description: r"Chinese military ID number (keyword-triggered, 8 digits)",
    ),
    PatternData(
        type_: r"social_security",
        label: r"[社保号已脱敏]",
        pattern: r"(?:社保号|社保卡号|社会保障号)\s*(?:[:：]?\s*)(?P<social_security>[1-9]\d{5}(?:19|20)\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])\d{3}[\dXx]|[A-Z]\d{8,12})",
        group: Some(r"social_security"),
        description: r"Chinese social security number (18-digit ID or city-specific format, keyword-triggered)",
    ),
    PatternData(
        type_: r"eep",
        label: r"[往来港澳通行证已脱敏]",
        pattern: r"(?:(?:中华人民共和国)?(?:电子)?往来港澳通行证(?:号码?)?|港澳通行证(?:号码?)?|双程证(?:号码?)?|EEP)\s*(?:[:：是为]?\s*)(?P<eep>C(?:[0-9]{8}|[A-HJ-NP-Z][0-9]{7}))(?!\w)",
        group: Some(r"eep"),
        check_context: true,
        description: r"EEP (往来港澳通行证) — C-prefix, 9 chars, no public checksum, anchor-required",
    ),
    PatternData(
        type_: r"hrp",
        label: r"[回乡证已脱敏]",
        pattern: r"(?:港澳居民来往内地通行证(?:号码?)?|来往内地通行证(?:号码?)?|回乡证(?:号码?)?|回乡卡|Home\s*Return\s*Permit)\s*(?:[:：是为]?\s*)(?P<hrp>[HM]\d{8}(?:\d{2})?)(?![0-9])",
        group: Some(r"hrp"),
        check_context: true,
        description: r"HRP (港澳居民来往内地通行证/回乡证) — H/M-prefix, 9(+2) digits, no public checksum, anchor-required",
    ),
    PatternData(
        type_: r"housing_fund",
        label: r"[公积金账号已脱敏]",
        pattern: r"(?:住房公积金|公积金)(?:账号码?|账户|帐号码?|帐户)\s*(?:[:：是为]?\s*)(?P<housing_fund>[0-9]{6,20})(?![0-9])",
        group: Some(r"housing_fund"),
        check_context: true,
        description: r"Housing provident fund account — no national format, anchor-required, digits only",
    ),
    PatternData(
        type_: r"job_title",
        label: r"[职务已脱敏]",
        pattern: r"(?:[\u4e00-\u9fff]{1,4}[的了]|的|了|是|找|问|请|让|给|跟|和|与)?(?P<job_title>[\u4e00-\u9fff]{0,4}(?:董事长|副董事长|总裁|副总裁|总经理|副总经理|总监|副总监|经理|副经理|主任|副主任|院长|副院长|局长|副局长|处长|科长|部长|厅长|司长|校长|园长|所长|站长|队长|组长|班长|排长|连长|教授|副教授|讲师|助教|研究员|工程师|高级工程师|医生|主治医生|主任医师|副主任医师|护士长|药剂师|会计师|审计师|律师|法官|检察官|CEO|CTO|CFO|COO|CIO|CMO|VP))",
        group: Some(r"job_title"),
        description: r"Job title (Chinese suffix + English abbreviations)",
    ),
    PatternData(
        type_: r"organization",
        label: r"[机构已脱敏]",
        pattern: r"(?:请查一下|请查下|查一下|一下|就职于|供职于|任职于|这是|那是|在|去|从|到|被|给|让|有|是|的|了)?(?P<organization>(?<!\d)[\u4e00-\u9fff]{2,12}(?>(?:股份有限公司|有限责任公司|有限公司|责任公司|集团公司|集团|公司|企业|工厂|银行|保险|证券|基金|医院|诊所|药房|事务所|研究院|研究所|实验室)))",
        group: Some(r"organization"),
        validator: Some(r"organization"),
        description: r"Chinese organization name (CJK prefix + legal/industry suffix)",
    ),
    PatternData(
        type_: r"school",
        label: r"[学校已脱敏]",
        pattern: r"(?:毕业于|就读于?|考入|考上|在|去|从|到|有|是)?(?P<school>(?<!\d)[\u4e00-\u9fff]{2,10}(?>(?:大学|学院|中学|小学|高中|初中|附中|附小|实验学校|外国语学校|师范学校|职业学校|技术学校|幼儿园|书院|学堂|党校)))",
        group: Some(r"school"),
        validator: Some(r"school"),
        description: r"Chinese school name (CJK prefix + educational suffix)",
    ),
    PatternData(
        type_: r"ethnicity",
        label: r"[民族已脱敏]",
        pattern: r"(?:民族\s*[:：]?\s*)(?:汉|蒙古|回|藏|维吾尔|苗|彝|壮|布依|朝鲜|满|侗|瑶|白|土家|哈尼|哈萨克|傣|黎|傈僳|佤|畲|高山|拉祜|水|东乡|纳西|景颇|柯尔克孜|土|达斡尔|仫佬|羌|布朗|撒拉|毛南|仡佬|锡伯|阿昌|普米|塔吉克|怒|乌孜别克|俄罗斯|鄂温克|德昂|保安|裕固|京|塔塔尔|独龙|鄂伦春|赫哲|门巴|珞巴|基诺)族|(?:汉|蒙古|回|藏|维吾尔|苗|彝|壮|布依|朝鲜|满|侗|瑶|白|土家|哈尼|哈萨克|傣|黎|傈僳|佤|畲|拉祜|水|东乡|纳西|景颇|柯尔克孜|达斡尔|仫佬|羌|布朗|撒拉|毛南|仡佬|锡伯|阿昌|普米|塔吉克|怒|乌孜别克|俄罗斯|鄂温克|德昂|保安|裕固|京|塔塔尔|独龙|鄂伦春|赫哲|门巴|珞巴|基诺)族",
        description: r"Chinese ethnicity (56 ethnic groups, keyword-triggered or standalone XX族)",
    ),
    PatternData(
        type_: r"workplace",
        label: r"[工作单位已脱敏]",
        pattern: r"(?:工作单位|单位|就职于|供职于|任职于)\s*[:：]?\s*(?P<workplace>[\u4e00-\u9fff]{2,20})",
        group: Some(r"workplace"),
        description: r"Chinese workplace (keyword-triggered, CJK text after keyword)",
    ),
    PatternData(
        type_: r"criminal_record",
        label: r"[犯罪记录已脱敏]",
        pattern: r"(?:有前科|犯罪记录|案底|刑事拘留|行政拘留|判刑[\u4e00-\u9fff\d]+[年月天]|拘留[\u4e00-\u9fff\d]+[天日]|被判处|缓刑|假释|取保候审|逮捕|起诉|定罪|服刑|入狱|坐牢|监禁)",
        description: r"Criminal record (explicit keywords: 前科/判刑/拘留/犯罪记录)",
    ),
    PatternData(
        type_: r"financial",
        label: r"[财务信息已脱敏]",
        pattern: r"(?:月薪|年薪|年收入|月收入|工资|底薪|税后收入|税前收入)[\d.]+[万元千百]+|(?:欠债|负债|欠款|贷款余额|房贷余额|车贷余额|信用卡欠款)[\d.]+[万元千百]+|信用评分\d+分?|(?:房贷|车贷|消费贷|网贷|借款)[\d.]+[万元千百]+",
        description: r"Financial info (salary/debt/credit score/loan with amounts)",
    ),
    PatternData(
        type_: r"biometric",
        label: r"[生物特征已脱敏]",
        pattern: r"(?:指纹(?:信息|采集|录入|比对|识别)|DNA(?:检测|鉴定|样本|比对|信息)|人脸(?:识别|采集|比对|信息|图像)|虹膜(?:扫描|识别|采集|信息)|声纹(?:录入|识别|采集|信息)|掌纹(?:采集|识别|信息)|基因(?:检测|信息|序列|样本))",
        description: r"Biometric data (fingerprint/DNA/face/iris/voiceprint)",
    ),
    PatternData(
        type_: r"medical",
        label: r"[医疗信息已脱敏]",
        pattern: r"(?:确诊|诊断为|患有|患了|罹患|检出|得了|查出来是|查出)(?P<medical>[\u4e00-\u9fff]{2,8})",
        group: Some(r"medical"),
        description: r"Medical diagnosis (keyword-triggered, preserves trigger verb)",
    ),
    PatternData(
        type_: r"medical",
        label: r"[医疗信息已脱敏]",
        pattern: r"(?:服用|注射|口服|开了)(?P<medical>[\u4e00-\u9fff\w]{2,10})",
        group: Some(r"medical"),
        description: r"Medical medication — strong triggers (服用/注射/口服/开了), any following term",
    ),
    PatternData(
        type_: r"medical",
        label: r"[医疗信息已脱敏]",
        pattern: r"(?:吃的|吃了)(?P<medical>[一-鿿]{1,7}(?:药|片|胶囊|丸|膏|针剂|冲剂|滴剂|颗粒|糖浆))",
        group: Some(r"medical"),
        description: r"Medical medication via the colloquial 吃的/吃了 trigger, gated on a drug suffix (药/片/胶囊…) so it captures 吃的降压药 but NOT 吃了海鲜大餐",
    ),
    PatternData(
        type_: r"medical",
        label: r"[医疗信息已脱敏]",
        pattern: r"HIV[阳阴]性|(?:乙肝|丙肝|艾滋病|癌症|肿瘤|白血病|糖尿病|高血压|冠心病|抑郁症|精神分裂|癫痫|肺结核|梅毒|淋病|尿毒症)|(?:布洛芬|阿司匹林|二甲双胍|阿莫西林|头孢|青霉素|胰岛素|奥美拉唑|氯雷他定|对乙酰氨基酚|感冒灵|板蓝根|连花清瘟)|[\u4e00-\u9fff]{2,6}手术",
        description: r"Medical standalone (HIV/disease names/common drug names/surgery)",
    ),
    PatternData(
        type_: r"religion",
        label: r"[宗教信仰已脱敏]",
        pattern: r"(?:基督徒|天主教徒|穆斯林|佛教徒|道教徒|印度教徒|犹太教徒|新教徒|东正教徒|摩门教徒)|(?:做礼拜|做弥撒|诵经|念佛|斋月|受洗入教|受洗|皈依|朝圣|祷告|礼拜日|安息日)|(?:信仰|信奉)[\u4e00-\u9fff]{2,6}",
        description: r"Religious belief (believer types/practices/declarations)",
    ),
    PatternData(
        type_: r"political",
        label: r"[政治观点已脱敏]",
        pattern: r"(?:政治面貌\s*[:：]?\s*[\u4e00-\u9fff]{2,6})|(?:党员|团员|共青团员|民主党派|无党派|群众)|(?:投票(?:给了?|支持)[\u4e00-\u9fff\w]{2,10})|(?:抗议游行|示威游行|集会抗议|政治集会|罢工)",
        description: r"Political opinion (party membership/voting/protest)",
    ),
    PatternData(
        type_: r"sexual_orientation",
        label: r"[性取向已脱敏]",
        pattern: r"(?:同性恋|双性恋|异性恋|无性恋|泛性恋)|(?:出柜|LGBTQ?|酷儿|GAY|gay|彩虹旗)",
        description: r"Sexual orientation (explicit terms)",
    ),
    PatternData(
        type_: r"self_reference",
        label: r"[自称已脱敏]",
        pattern: r"我(?:妈妈|爸爸|母亲|父亲|老公|老婆|丈夫|妻子|先生|太太|儿子|女儿|哥哥|姐姐|弟弟|妹妹|哥|姐|弟|妹|妈|爸|爷爷|奶奶|外公|外婆|叔叔|阿姨|舅舅|姑姑|家人|家里人|孩子)",
        description: r"Self-reference with kinship (我妈/我爸/我老公/...)",
    ),
    PatternData(
        type_: r"self_reference",
        label: r"[自称已脱敏]",
        pattern: r"我们的|我们|我的|我",
        description: r"Self-reference pronoun (我/我的/我们/我们的)",
    ),
]
